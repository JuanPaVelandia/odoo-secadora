<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Privilegio propio (v19): no se comparte con otros módulos, ver
             memory/privilegios-grupos-v19.md -->
        <record id="res_groups_privilege_combustible" model="res.groups.privilege">
            <field name="name">Combustible</field>
            <field name="category_id" ref="finca_labores.module_category_finca_labores"/>
        </record>

        <!-- Ve el menú y el resumen de ACPM por finca y campaña. Marcar y
             asignar las líneas de factura requiere además el rol de
             facturación, porque se escribe sobre las líneas de la factura. -->
        <record id="group_combustible" model="res.groups">
            <field name="name">Combustible</field>
            <field name="privilege_id" ref="res_groups_privilege_combustible"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="acpm_compra_company_rule" model="ir.rule">
            <field name="name">Compra de ACPM: Multi-Company</field>
            <field name="model_id" ref="model_secadora_acpm_compra"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
