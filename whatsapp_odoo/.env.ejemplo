# Copia a .env y rellena. Ignorado por git.

# --- Quién puede preguntar (separados por coma, con indicativo país) ---
# Sin esto el bot ignora TODOS los mensajes.
NUMEROS_AUTORIZADOS=573209860118,573001112233

# --- API de Claude (se factura por uso) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODELO=claude-opus-5

# --- Canal de mensajería: 'meta' (oficial) o 'evolution' ---
# meta: API oficial de WhatsApp Business. Automatizar es su propósito, así
#   que no restringen el número. NO da acceso a grupos.
# evolution: sobre Baileys. Lee grupos, pero WhatsApp puede restringir el
#   número por spam (nos pasó el 2026-07-26).
CANAL=meta

# --- Si CANAL=meta ---
META_TOKEN=EAA...
META_PHONE_NUMBER_ID=el-id-numerico-del-numero-en-meta
META_VERIFY_TOKEN=inventa-una-cadena-secreta-aqui
META_API_VERSION=v21.0

# --- Si CANAL=evolution ---
# EVOLUTION_API_URL=https://whatsapp-facturas-evolution-api.h4syfu.easypanel.host
# EVOLUTION_API_KEY=la-misma-del-proyecto-de-facturas
# WHATSAPP_INSTANCE=jpv_bot

# --- Base de datos de Odoo (rol de solo lectura) ---
# En el VPS, Postgres es local: no hace falta túnel.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=secadora_2
PG_USER=claude_lectura
PG_PASSWORD=la-contrasena-del-rol

# Filestore de Odoo (se monta como volumen en el contenedor)
ODOO_FILESTORE=/odoo-filestore

PUERTO=8080
LOG_LEVEL=INFO
