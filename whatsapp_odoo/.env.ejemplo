# --- Base de datos de Odoo (rol de solo lectura) ---
# En el VPS, Postgres es local: no hace falta túnel.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=secadora_2
PG_USER=claude_lectura
PG_PASSWORD=la-contrasena-del-rol

# Filestore de Odoo (se monta como volumen en el contenedor)
ODOO_FILESTORE=/odoo-filestore

PUERTO=8080
LOG_LEVEL=INFO
