<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_semilla_terceros_list" model="ir.ui.view">
            <field name="name">secadora.despacho.bultos.semilla.terceros.list</field>
            <field name="model">secadora.despacho.bultos</field>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <list string="Semilla a terceros" create="0" edit="0" delete="0"
                      default_order="fecha_entrega desc">
                    <field name="fecha_entrega"/>
                    <field name="tercero_semilla_id"/>
                    <field name="variedad_id"/>
                    <field name="cantidad" string="Bultos" sum="Total"/>
                    <field name="peso_subtotal" string="Kg" sum="Total"/>
                    <field name="bodega_id"/>
                    <field name="remision_id" optional="show"/>
                    <field name="pesaje_id" optional="show"/>
                    <field name="orden_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_semilla_terceros_pivot" model="ir.ui.view">
            <field name="name">secadora.despacho.bultos.semilla.terceros.pivot</field>
            <field name="model">secadora.despacho.bultos</field>
            <field name="arch" type="xml">
                <pivot string="Semilla a terceros">
                    <field name="tercero_semilla_id" type="row"/>
                    <field name="variedad_id" type="col"/>
                    <field name="cantidad" type="measure" string="Bultos"/>
                    <field name="peso_subtotal" type="measure" string="Kg"/>
                </pivot>
            </field>
        </record>

        <record id="view_semilla_terceros_search" model="ir.ui.view">
            <field name="name">secadora.despacho.bultos.semilla.terceros.search</field>
            <field name="model">secadora.despacho.bultos</field>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tercero_semilla_id"/>
                    <field name="variedad_id"/>
                    <field name="bodega_id"/>
                    <filter name="fecha" string="Fecha" date="fecha_entrega"/>
                    <group>
                        <filter name="por_tercero" string="Tercero"
                                context="{'group_by': 'tercero_semilla_id'}"/>
                        <filter name="por_variedad" string="Variedad"
                                context="{'group_by': 'variedad_id'}"/>
                        <filter name="por_mes" string="Mes"
                                context="{'group_by': 'fecha_entrega:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_semilla_terceros" model="ir.actions.act_window">
            <field name="name">Semilla a terceros</field>
            <field name="res_model">secadora.despacho.bultos</field>
            <field name="view_mode">list,pivot</field>
            <field name="domain">[('tercero_semilla_id', '!=', False), ('confirmado', '=', True)]</field>
            <field name="context">{'search_default_por_tercero': 1}</field>
            <field name="search_view_id" ref="view_semilla_terceros_search"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_semilla_terceros_list')}),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_semilla_terceros_pivot')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Aún no se ha entregado semilla a cambio de arroz</p>
                <p>Se registra en la remisión de bodega (tipo de entrega "A cambio de arroz")
                   o en la línea de despacho del pesaje de salida ("A cambio de arroz para").</p>
            </field>
        </record>

        <menuitem id="menu_semilla_terceros"
                  name="Semilla a terceros"
                  parent="bascula.menu_bascula_bultos"
                  action="action_semilla_terceros"
                  sequence="40"/>

    </data>
</odoo>
