<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_co_exogenous_certificate_config_form" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_certificate_config.form</field>
        <field name="model">l10n_co.exogenous_certificate_config</field>
        <field name="arch" type="xml">
            <form string="Configuración de certificados">
                <header>
                    <button name="action_open_mass_send_wizard"
                            string="Envío masivo de certificados"
                            type="object"
                            class="oe_highlight"
                            icon="fa-paper-plane"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="certificate_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="report_title" placeholder="Ej: CERTIFICADO DE RETENCIÓN DEL IMPUESTO DE INDUSTRIA Y COMERCIO"/>
                        </group>
                        <group>
                            <field name="report_style"/>
                            <field name="article"/>
                            <field name="consecutive_sequence_id"/>
                            <field name="signer_name"/>
                            <field name="signer_position"/>
                            <field name="signer_signature" widget="image" class="oe_avatar"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cuentas contables" name="accounts">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="concept_name" placeholder="Nombre personalizado (opcional)"/>
                                    <field name="account_pattern" optional="show"/>
                                    <field name="account_ids" widget="many2many_tags" optional="show"/>
                                    <field name="account_count"/>
                                    <field name="nature_account"/>
                                    <field name="city_id" invisible="parent.certificate_type != 'ica'"/>
                                    <field name="certificate_type" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cuentas compras / IVA"
                              name="iva_accounts" invisible="certificate_type != 'iva'">
                            <group>
                                <field name="purchase_account_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="iva_deductible_account_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Plantilla" name="template">
                            <field name="report_template"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_co_exogenous_certificate_config_tree" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_certificate_config.list</field>
        <field name="model">l10n_co.exogenous_certificate_config</field>
        <field name="arch" type="xml">
            <list>
                <field name="certificate_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="report_title"/>
                <field name="article"/>
            </list>
        </field>
    </record>

    <record id="l10n_co_exogenous_certificate_config_search" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_certificate_config.search</field>
        <field name="model">l10n_co.exogenous_certificate_config</field>
        <field name="arch" type="xml">
            <search>
                <field name="certificate_type"/>
                <field name="company_id"/>
                <filter name="ica" string="ICA" domain="[('certificate_type', '=', 'ica')]"/>
                <filter name="iva" string="IVA" domain="[('certificate_type', '=', 'iva')]"/>
                <filter name="timbre" string="Timbre" domain="[('certificate_type', '=', 'timbre')]"/>
                <filter name="fuente" string="Fuente" domain="[('certificate_type', '=', 'fuente')]"/>
            </search>
        </field>
    </record>

    <record id="l10n_co_exogenous_certificate_config_action" model="ir.actions.act_window">
        <field name="name">Configuración de certificados</field>
        <field name="res_model">l10n_co.exogenous_certificate_config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure las cuentas contables para cada tipo de certificado de retención
            </p>
            <p>
                Defina las cuentas contables de retención para ICA, IVA, Timbre y Fuente.
                Para ICA puede asociar una ciudad a cada cuenta.
            </p>
        </field>
    </record>

</odoo>
