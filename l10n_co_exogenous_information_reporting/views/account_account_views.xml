<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_account_form_exogenous" model="ir.ui.view">
        <field name="name">account.account.form.exogenous</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 18: el form nativo tiene <page name="accounting"> dentro del notebook.
                 Agregamos el grupo "Información exógena" al final del page accounting. -->
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Información exógena" name="exogenous_info">
                    <field name="l10n_co_exo_is_mayor_valor"/>
                    <field name="l10n_co_exo_is_retention"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
