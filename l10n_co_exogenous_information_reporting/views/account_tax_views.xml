<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_tax_form_exogenous" model="ir.ui.view">
        <field name="name">account.tax.form.exogenous</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='advanced_booleans']" position="after">
                <group string="Información exógena" name="exogenous_info">
                    <field name="l10n_co_exo_is_mayor_valor"/>
                    <field name="l10n_co_exo_is_retention"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
