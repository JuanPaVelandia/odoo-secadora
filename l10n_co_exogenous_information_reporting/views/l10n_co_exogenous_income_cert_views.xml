<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================== -->
    <!--  Configuración de Certificado de Ingresos y Retenciones    -->
    <!-- ========================================================== -->

    <record id="l10n_co_exogenous_income_cert_config_tree" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_config.tree</field>
        <field name="model">l10n_co.exogenous_income_cert_config</field>
        <field name="arch" type="xml">
            <list decoration-success="configuration_complete == True"
                  decoration-warning="configuration_complete == False">
                <field name="name"/>
                <field name="year"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="form_number"/>
                <field name="issue_date"/>
                <field name="uvt_value"/>
                <field name="patrimony_cop" widget="monetary"/>
                <field name="income_cop" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="missing_items_count"/>
                <field name="configuration_complete" widget="boolean_toggle"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_config_form" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_config.form</field>
        <field name="model">l10n_co.exogenous_income_cert_config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Certificado de Ingresos">
                <header>
                    <button name="action_open_wizard" type="object"
                            string="Generar Certificado"
                            class="oe_highlight"
                            icon="fa-file-text-o"/>
                    <button name="action_compute_from_parameters" type="object"
                            string="Recalcular UVT"
                            icon="fa-refresh"/>
                    <button name="action_load_default_configuration" type="object"
                            string="Cargar configuración por defecto"
                            icon="fa-magic"
                            confirm="Esto reemplazará las líneas existentes con la configuración por defecto. ¿Desea continuar?"/>
                    <button name="action_auto_configure_rules" type="object"
                            string="Auto-asignar reglas salariales"
                            icon="fa-cogs"/>
                    <button name="action_view_configuration_status" type="object"
                            string="Ver estado de configuración"
                            icon="fa-list-alt"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado"
                            bg_color="bg-danger" invisible="active == True"/>
                    <widget name="web_ribbon" title="Configuración Completa"
                            bg_color="bg-success" invisible="configuration_complete == False"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Ej: Certificado 2024 - Empresa XYZ"/></h1>
                    </div>
                    <group>
                        <group string="Datos básicos">
                            <field name="year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="form_number"/>
                            <field name="issue_date"/>
                            <field name="description"/>
                        </group>
                        <group string="UVT y Límites">
                            <field name="uvt_value"/>
                            <field name="patrimony_uvt"/>
                            <field name="income_uvt"/>
                            <field name="patrimony_cop" widget="monetary"/>
                            <field name="income_cop" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="missing_items_count"/>
                            <field name="configuration_complete" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Configuración" name="lines">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="is_configured == True"
                                      decoration-muted="is_configured == False">
                                    <field name="sequence" widget="handle"/>
                                    <field name="calculation"/>
                                    <field name="name"/>
                                    <field name="type_partner"/>
                                    <field name="information_fields_id"
                                           invisible="calculation in ('sum_rule', 'dependents_type_vat', 'dependents_vat', 'dependents_name', 'dependents_type')"/>
                                    <field name="information_fields_relation" optional="hide"/>
                                    <field name="related_field_id" optional="hide"/>
                                    <field name="salary_rule_id" widget="many2many_tags"
                                           invisible="calculation != 'sum_rule'"/>
                                    <field name="origin_severance_pay" optional="hide"/>
                                    <field name="accumulated_previous_year" optional="hide"/>
                                    <field name="severance_paid_previous_year" optional="hide"/>
                                    <field name="account_move_type" optional="hide"/>
                                    <field name="move_state_filter" optional="hide"/>
                                    <field name="exclude_payroll_entries" optional="hide"/>
                                    <field name="limit_uvt_factor" optional="hide"/>
                                    <field name="limit_uvt_cop" widget="monetary" optional="hide"/>
                                    <field name="limit_fixed_value" optional="hide"/>
                                    <field name="reference_sequence" optional="hide"/>
                                    <field name="operation_mode" optional="hide"/>
                                    <field name="is_configured" widget="boolean_toggle"/>
                                </list>
                                <form string="Línea de Configuración">
                                    <sheet>
                                        <group>
                                            <group string="Definición">
                                                <field name="sequence"/>
                                                <field name="calculation"/>
                                                <field name="name"/>
                                                <field name="type_partner"/>
                                                <field name="reference_sequence"/>
                                                <field name="operation_mode"/>
                                            </group>
                                            <group string="Campos relacionados"
                                                   invisible="calculation in ('sum_rule', 'dependents_type_vat', 'dependents_vat', 'dependents_name', 'dependents_type')">
                                                <field name="information_fields_id"/>
                                                <field name="information_fields_relation"/>
                                                <field name="related_field_id"/>
                                            </group>
                                        </group>
                                        <group string="Reglas Salariales"
                                               invisible="calculation != 'sum_rule'">
                                            <field name="salary_rule_id" widget="many2many_tags"/>
                                            <field name="origin_severance_pay"/>
                                            <field name="accumulated_previous_year"/>
                                            <field name="sequence_list_sum"/>
                                            <field name="severance_paid_previous_year"/>
                                            <field name="salary_rule_category_ids" widget="many2many_tags"/>
                                        </group>
                                        <group string="Filtro contable">
                                            <field name="account_ids" widget="many2many_tags"/>
                                            <field name="account_move_type"/>
                                            <field name="excluded_journal_ids" widget="many2many_tags"/>
                                            <field name="move_state_filter"/>
                                            <field name="exclude_payroll_entries"/>
                                            <field name="account_move_domain"/>
                                        </group>
                                        <group string="Límites">
                                            <field name="limit_uvt_factor"/>
                                            <field name="limit_uvt_cop" widget="monetary"/>
                                            <field name="limit_fixed_value"/>
                                        </group>
                                        <group string="Condición Python">
                                            <field name="python_condition" nolabel="1"/>
                                        </group>
                                        <field name="is_configured" invisible="1"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Cuentas y Diarios" name="accounts">
                            <group>
                                <field name="account_ids" widget="many2many_tags"/>
                                <field name="excluded_journal_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Plantilla del Certificado" name="template">
                            <field name="report_template" widget="html"
                                   options="{'sanitize': false}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_config_search" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_config.search</field>
        <field name="model">l10n_co.exogenous_income_cert_config</field>
        <field name="arch" type="xml">
            <search string="Configuración Certificado de Ingresos">
                <field name="name"/>
                <field name="year"/>
                <field name="form_number"/>
                <field name="company_id"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Configuración completa" name="complete"
                        domain="[('configuration_complete', '=', True)]"/>
                <filter string="Configuración incompleta" name="incomplete"
                        domain="[('configuration_complete', '=', False)]"/>
                <group>
                    <filter string="Año" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Compañía" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_config_action" model="ir.actions.act_window">
        <field name="name">Configuración de Certificado de Ingresos</field>
        <field name="res_model">l10n_co.exogenous_income_cert_config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_co_exogenous_income_cert_config_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una configuración de certificado de ingresos
            </p>
            <p>
                La configuración define los valores UVT, las cuentas, las reglas salariales
                y la plantilla HTML utilizada para generar el certificado anual de ingresos
                y retenciones.
            </p>
        </field>
    </record>

    <!-- ========================================================== -->
    <!--  Solicitud de Certificado de Ingresos y Retenciones        -->
    <!-- ========================================================== -->

    <record id="l10n_co_exogenous_income_cert_request_tree" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_request.tree</field>
        <field name="model">l10n_co.exogenous_income_cert_request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'"
                  decoration-info="state == 'requested'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="year"/>
                <field name="header_id"/>
                <field name="output_format"/>
                <field name="request_date"/>
                <field name="generation_date"/>
                <field name="email_sent" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'requested'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_request_form" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_request.form</field>
        <field name="model">l10n_co.exogenous_income_cert_request</field>
        <field name="arch" type="xml">
            <form string="Solicitud Certificado de Ingresos">
                <header>
                    <button name="action_request" type="object"
                            string="Solicitar"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate" type="object"
                            string="Generar Certificado"
                            class="oe_highlight"
                            icon="fa-cogs" invisible="state not in ('draft', 'requested')"/>
                    <button name="action_generate_qweb_pdf" type="object"
                            string="Generar PDF (QWeb)"
                            icon="fa-file-pdf-o" invisible="state not in ('draft', 'requested')"/>
                    <button name="action_send_email" type="object"
                            string="Enviar por correo"
                            icon="fa-envelope" invisible="state != 'done' or pdf_file == False"/>
                    <button name="action_generate_and_send" type="object"
                            string="Generar y Enviar"
                            class="oe_highlight"
                            icon="fa-paper-plane" invisible="state not in ('draft', 'requested')"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar" invisible="state in ('cancelled', 'done')"/>
                    <button name="action_draft" type="object"
                            string="Volver a Borrador" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos del Empleado">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Configuración">
                            <field name="header_id" readonly="state != 'draft'"/>
                            <field name="year" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Salida">
                            <field name="output_format"/>
                            <field name="send_by_email"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="request_date"/>
                            <field name="generation_date"/>
                            <field name="email_sent"/>
                            <field name="email_sent_date" invisible="email_sent == False"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Archivos Generados" name="files" invisible="state != 'done'">
                            <group>
                                <group>
                                    <field name="pdf_file" filename="pdf_filename" invisible="pdf_file == False"/>
                                    <field name="pdf_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="excel_file" filename="excel_filename" invisible="excel_file == False"/>
                                    <field name="excel_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Vista Previa" name="preview" invisible="state == 'draft'">
                            <field name="preview_html" widget="html" options="{'sanitize': false}" readonly="1"/>
                        </page>
                        <page string="Observaciones" name="notes">
                            <field name="notes" placeholder="Observaciones internas..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_request_search" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_income_cert_request.search</field>
        <field name="model">l10n_co.exogenous_income_cert_request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de Certificado">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="header_id"/>
                <field name="year"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Solicitado" name="requested" domain="[('state', '=', 'requested')]"/>
                <filter string="Generado" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelado" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Correo enviado" name="email_sent" domain="[('email_sent', '=', True)]"/>
                <filter string="Correo pendiente" name="email_pending"
                        domain="[('email_sent', '=', False), ('state', '=', 'done')]"/>
                <group>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Año" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Configuración" name="group_header" context="{'group_by': 'header_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_co_exogenous_income_cert_request_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de Certificado de Ingresos</field>
        <field name="res_model">l10n_co.exogenous_income_cert_request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_co_exogenous_income_cert_request_search"/>
        <field name="context">{'search_default_draft': 1, 'search_default_requested': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Solicite un certificado de ingresos y retenciones
            </p>
            <p>
                Cada solicitud genera el certificado anual de un empleado en PDF
                o Excel, con opción de enviar por correo electrónico.
            </p>
        </field>
    </record>

    <!-- Secuencia para el name de la solicitud -->
    <record id="seq_l10n_co_exogenous_income_cert_request" model="ir.sequence">
        <field name="name">Solicitud Certificado de Ingresos</field>
        <field name="code">l10n_co.exogenous_income_cert_request</field>
        <field name="prefix">CERT/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
