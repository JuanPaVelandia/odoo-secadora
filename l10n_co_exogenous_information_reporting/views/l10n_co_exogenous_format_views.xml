<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_co_exogenous_format_view_search" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.format.view.search</field>
        <field name="model">l10n_co.exogenous_format</field>
        <field name="arch" type="xml">
            <search string="Buscar formato">
                <field name="name"/>
                <field name="code"/>
                <field name="year"/>
                <filter domain="[('report_type','=', 'dian')]" name="filter_dian" string="DIAN (Nacional)"/>
                <filter domain="[('report_type','=', 'district')]" name="filter_district" string="Distrital (ICA)"/>
                <separator/>
                <filter domain="[('year','=', 2024)]" name="filter_year_2024" string="Año 2024"/>
                <filter domain="[('year','=', 2025)]" name="filter_year_2025" string="Año 2025"/>
                <separator/>
                <filter domain="[('active','=', False)]" name="inactive" string="Archivado"/>
                <filter domain="[('is_it_with_date_range','=', True)]" name="is_it_with_date_range" string="¿Con rango de fechas?"/>
                <filter domain="[('apply_concepts','=', True)]" name="apply_concepts" string="¿Aplicar conceptos?"/>
                <filter domain="[('applying_smaller_amounts','=', True)]" name="applying_smaller_amounts" string="¿Aplicar cuantías menores?"/>
                <group>
                    <filter context="{'group_by': 'year'}" name="group_year" string="Año gravable"/>
                    <filter context="{'group_by': 'company_id'}" groups="base.group_multi_company" name="company_id" string="Compañía"/>
                    <filter context="{'group_by': 'document_type_table_id'}" name="document_type_table_id" string="Tabla de tipos de documento"/>
                </group>
            </search></field>
    </record>
    <record id="l10n_co_exogenous_format_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.format.view.form</field>
        <field name="model">l10n_co.exogenous_format</field>
        <field name="arch" type="xml">
            <form string="Formato">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_load_fields_from_xsd" type="object" class="oe_stat_button" icon="fa-file-code-o" invisible="xml_element_name == False">
                            <span>Cargar campos XSD</span>
                        </button>
                    </div>
                    <widget bg_color="bg-danger"  name="web_ribbon" title="Archived" invisible="active == True"/>
                    <div class="oe_title" name="l10n_co_exogenous_format_title">
                        <label for="code" id="l10n_co_exogenous_format_title"/>
                        <h1>
                            <field class="d-block" name="code" required="1"/>
                            <field invisible="1" name="active"/>
                        </h1>
                    </div>
                    <group>
                        <group name="info_left">
                            <field name="report_type"/>
                            <field name="year"/>
                            <field name="version"/>
                            <field name="appendix"/>
                        </group>
                        <group name="info_right">
                            <field name="district_id" options="{'no_create': True}" invisible="report_type != 'district'"/>
                            <field name="document_type_table_id" options="{'no_create': True}"/>
                            <field groups="base.group_multi_company" name="company_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group name="info_left">
                            <field name="applying_smaller_amounts"/>
                            <field name="is_it_with_date_range"/>
                            <field name="apply_concepts"/>
                        </group>
                        <group name="info_right">
                            <field invisible="1" name="company_currency_id"/>
                            <field  name="smaller_ammounts" invisible="applying_smaller_amounts == False"/>
                        </group>
                    </group>
                    <group string="Configuración XML/XSD">
                        <group name="xml_left">
                            <field name="xml_element_name" placeholder="ej: pagos, ingresos"/>
                            <field name="xml_root_element"/>
                            <field name="xsd_version"/>
                        </group>
                        <group name="xml_right">
                            <field name="xsd_file" filename="xsd_file_name"/>
                            <field name="xsd_file_name" invisible="1"/>
                        </group>
                    </group>
                    <group colspan="4" name="group_name">
                        <field colspan="2" name="name" required="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form></field>
    </record>
    <record id="l10n_co_exogenous_format_view_tree" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.format.view.tree</field>
        <field name="model">l10n_co.exogenous_format</field>
        <field name="arch" type="xml">
            <list string="Formatos">
                <field name="code"/>
                <field name="name"/>
                <field name="report_type"/>
                <field name="year"/>
                <field name="version"/>
                <field name="appendix"/>
                <field name="document_type_table_id" optional="hide"/>
                <field name="is_it_with_date_range" optional="hide"/>
                <field name="apply_concepts" optional="hide"/>
                <field name="applying_smaller_amounts" optional="hide"/>
                <field name="smaller_ammounts" optional="hide"/>
                <field groups="base.group_multi_company" name="company_id" optional="hide"/>
            </list></field>
    </record>
    <record id="l10n_co_exogenous_format_action" model="ir.actions.act_window">
        <field name="name">Formatos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_co.exogenous_format</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree sus formatos aquí.
            </p></field>
    </record>
</odoo>
