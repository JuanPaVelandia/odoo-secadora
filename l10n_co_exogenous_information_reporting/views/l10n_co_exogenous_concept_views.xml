<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_co_exogenous_concept_view_search" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.concept.view.search</field>
        <field name="model">l10n_co.exogenous_concept</field>
        <field name="arch" type="xml">
            <search string="Buscar conceptos">
                <field name="name"/>
                <field name="code"/>
                <field name="format_id"/>
                <separator/>
                <filter string="Con cuentas" name="with_accounts"
                        domain="[('account_count', '>', 0)]"/>
                <filter string="Sin cuentas" name="without_accounts"
                        domain="[('account_count', '=', 0)]"/>
                <separator/>
                <filter domain="[('active','=', False)]" name="inactive" string="Archivado"/>
                <group>
                    <filter context="{'group_by': 'format_id'}" name="format_id" string="Formato"/>
                    <filter context="{'group_by': 'company_id'}" groups="base.group_multi_company" name="company_id" string="Compañía"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_co_exogenous_concept_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.concept.view.form</field>
        <field name="model">l10n_co.exogenous_concept</field>
        <field name="arch" type="xml">
            <form string="Concepto">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list"
                                 type="object"
                                name="action_view_all_accounts" invisible="account_count == 0">
                            <field name="account_count" widget="statinfo" string="Cuentas"/>
                        </button>
                    </div>
                    <widget bg_color="bg-danger"  name="web_ribbon" title="Archivado" invisible="active != False"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="Ej: 5002" required="1"/>
                        </h1>
                        <field name="active" invisible="1"/>
                    </div>
                    <group>
                        <group string="Información general">
                            <field name="format_id" options="{'no_create': True}" required="1"/>
                            <field name="report_with_informan_nit"/>
                        </group>
                        <group string="Compañía">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" required="1" placeholder="Descripción del concepto"/>
                    </group>
                    <notebook>
                        <page string="Configuración por campo" name="field_accounts">
                            <div class="alert alert-info mb-2" role="alert">
                                <strong><i class="fa fa-info-circle"/> Cómo configurar:</strong>
                                <ol class="mb-0 mt-1">
                                    <li>Seleccione la <strong>Columna del reporte</strong> (atributo XSD que genera valor, ej: pago, retp, reta)</li>
                                    <li>Escriba un <strong>Patrón de cuentas</strong> con % como comodín (ej: 5105%, 5110%) o seleccione cuentas manualmente</li>
                                    <li>Elija la <strong>Fórmula DIAN</strong> que define cómo se acumula el valor:
                                        DB = solo débitos, CR = solo créditos, DB-CR = débito menos crédito, Base almacenada = tax_base_amount</li>
                                    <li>La columna <strong>No. Cuentas</strong> muestra cuántas cuentas tiene asignadas cada línea</li>
                                </ol>
                            </div>
                            <field name="field_account_ids" nolabel="1">
                                <list editable="bottom" decoration-warning="account_count == 0">
                                    <field name="company_id" invisible="1"/>
                                    <field name="format_field_id"
                                           string="Columna del reporte"
                                           options="{'no_create': True}"
                                           domain="[('format_ids', 'in', parent.format_id), ('source', '=', 'journal_items')]"
                                           required="1"/>
                                    <field name="account_pattern" string="Patrón cuentas" placeholder="Ej: 5105%, 5110%"/>
                                    <field name="account_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           string="Cuentas asignadas"/>
                                    <field name="nature_account" string="Fórmula DIAN"/>
                                    <field name="account_count" string="No. Cuentas"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_co_exogenous_concept_view_tree" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.concept.view.tree</field>
        <field name="model">l10n_co.exogenous_concept</field>
        <field name="arch" type="xml">
            <list string="Conceptos" decoration-warning="account_count == 0">
                <field name="code"/>
                <field name="name"/>
                <field name="format_id"/>
                <field name="field_account_count" string="Campos"/>
                <field name="account_count" string="No. Cuentas"/>
                <field name="report_with_informan_nit" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="l10n_co_exogenous_concept_action" model="ir.actions.act_window">
        <field name="name">Conceptos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_co.exogenous_concept</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_co_exogenous_concept_view_search"/>
        <field name="context">{'search_default_format_id': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear conceptos para información exógena
            </p>
            <p>
                Los conceptos definen las categorías de información a reportar a la DIAN.
                Configure las cuentas contables en la pestaña "Configuración por campo"
                de cada concepto.
            </p>
        </field>
    </record>

</odoo>
