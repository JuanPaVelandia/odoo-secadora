<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista del Plan jerárquico de Conceptos -->
    <record id="l10n_co_exogenous_concept_plan_wizard_form" model="ir.ui.view">
        <field name="name">l10n_co.exogenous.concept.plan.wizard.form</field>
        <field name="model">l10n_co.exogenous_concept_plan_wizard</field>
        <field name="arch" type="xml">
            <form string="Plan de configuración de conceptos">
                <!-- Header KPIs -->
                <div class="row mb-3 mx-0">
                    <div class="col-3">
                        <div class="card bg-primary text-white text-center p-2">
                            <div class="h3 mb-0"><field name="total_concepts" readonly="1" nolabel="1"/></div>
                            <small>Conceptos</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card bg-info text-white text-center p-2">
                            <div class="h3 mb-0"><field name="total_columns" readonly="1" nolabel="1"/></div>
                            <small>Columnas</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card bg-success text-white text-center p-2">
                            <div class="h3 mb-0"><field name="total_configured" readonly="1" nolabel="1"/></div>
                            <small>Configurados</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card bg-secondary text-white text-center p-2">
                            <div class="h3 mb-0"><field name="total_accounts" readonly="1" nolabel="1"/></div>
                            <small>Cuentas totales</small>
                        </div>
                    </div>
                </div>

                <!-- Selección de formato -->
                <group col="6">
                    <field name="format_id" options="{'no_create': True}" colspan="2"/>
                    <field name="format_setting_id"
                           domain="[('format_id', '=', format_id)]"
                           options="{'no_create': True}"
                           colspan="2"
                           placeholder="Asociar a config. existente..."/>
                    <field name="company_id" readonly="1" invisible="1"/>
                    <field name="apply_concepts" invisible="1"/>
                </group>

                <!-- Barra de acciones masivas -->
                <div class="d-flex gap-2 mb-3 ms-2 flex-wrap">
                    <button name="action_build_tree" type="object"
                            string="Reconstruir árbol" class="btn-secondary btn-sm"
                            icon="fa-refresh"/>
                    <button name="action_suggest_all_patterns" type="object"
                            string="Sugerir todos" class="btn-warning btn-sm"
                            icon="fa-magic" invisible="apply_concepts == False"/>
                    <button name="action_load_all_patterns" type="object"
                            string="Cargar cuentas" class="btn-info btn-sm"
                            icon="fa-download" invisible="apply_concepts == False"/>
                    <button name="action_sync_all_to_setting" type="object"
                            string="Sincronizar con config." class="btn-primary btn-sm"
                            icon="fa-upload"
                            
                            confirm="¿Sincronizar todas las líneas con la configuración del formato?" invisible="format_setting_id == False"/>
                </div>

                <notebook>
                    <!-- PESTAÑA 1: Árbol jerárquico -->
                    <page string="Árbol de conceptos" name="tree">
                        <field name="tree_line_ids" nolabel="1">
                            <list decoration-success="status == 'configured'"
                                  decoration-muted="status == 'empty'"
                                  decoration-bf="node_type == 'concept'"
                                  create="0" delete="0"
                                  limit="80">
                                <field name="icon" string="" nolabel="1" width="30px"/>
                                <field name="display_name_computed" string="Estructura"/>
                                <field name="node_type" string="Tipo" widget="badge"
                                       decoration-info="node_type == 'concept'"
                                       decoration-success="node_type == 'column'"
                                       optional="hide"/>
                                <field name="nature_display" string="Fórmula"/>
                                <field name="account_pattern_display" string="Patrón"/>
                                <field name="account_count_display" string="# Ctas"/>
                                <field name="status" string="Estado" widget="badge"
                                       decoration-success="status == 'configured'"
                                       decoration-warning="status == 'empty'"/>
                                <field name="sequence" invisible="1"/>
                                <field name="level" invisible="1"/>
                                <field name="concept_id" invisible="1"/>
                                <field name="format_field_id" invisible="1"/>
                                <field name="wizard_id" invisible="1"/>
                            </list>
                        </field>
                    </page>

                    <!-- PESTAÑA 2: Panel de detalle (nodo seleccionado) -->
                    <page string="Configurar nodo" name="detail">
                        <group string="Nodo seleccionado" col="4">
                            <field name="selected_concept_id"
                                   domain="[('format_id', '=', format_id), ('company_id', '=', company_id)]"
                                   options="{'no_create': True}"/>
                            <field name="selected_field_id"
                                   domain="[('format_ids', '=', format_id), ('source', '=', 'journal_items')]"
                                   options="{'no_create': True}"/>
                        </group>

                        <group string="Configuración de cuentas" col="4">
                            <field name="selected_account_pattern"
                                   placeholder="Ej: 5105%, 2365%"/>
                            <field name="selected_nature"/>
                            <field name="selected_account_count"/>
                        </group>

                        <group string="Dominio personalizado" col="2">
                            <div class="alert alert-info mb-2" role="alert" colspan="2">
                                <i class="fa fa-info-circle"/> Dominio para filtrar líneas contables
                                (<code>account.move.line</code>) de este concepto+columna.
                                Se combina con las exclusiones generales del formato.
                            </div>
                            <field name="selected_custom_domain"
                                   widget="domain"
                                   options="{'model': 'account.move.line'}"
                                   colspan="2"/>
                            <button name="action_test_domain" type="object"
                                    string="Probar dominio" class="btn-secondary btn-sm"
                                    icon="fa-check"/>
                        </group>

                        <group string="Exclusiones específicas" col="4">
                            <field name="exclude_partner_ids" widget="many2many_tags"
                                   placeholder="Terceros a excluir de este concepto..."
                                   options="{'no_create': True}"/>
                            <field name="exclude_journal_ids" widget="many2many_tags"
                                   placeholder="Diarios a excluir..."
                                   options="{'no_create': True}"/>
                            <field name="exclude_move_type"/>
                            <field name="selected_line_tax_filter"/>
                        </group>

                        <group string="Parámetros avanzados" col="4">
                            <field name="selected_corte"/>
                        </group>

                        <div class="d-flex gap-2 mt-3">
                            <button name="action_apply_node_config" type="object"
                                    string="Aplicar configuración" class="btn-primary"
                                    icon="fa-save"/>
                        </div>
                    </page>

                    <!-- PESTAÑA 3: Ayuda -->
                    <page string="Ayuda" name="help">
                        <group colspan="2">
                            <div class="alert alert-info" role="alert">
                                <h4>Plan de configuración jerárquico</h4>
                                <p>Este asistente muestra la estructura jerárquica completa del formato de exógena:</p>
                                <ol>
                                    <li><strong>Árbol:</strong> Vea todos los conceptos y sus columnas de un vistazo</li>
                                    <li><strong>Estados:</strong>
                                        <span class="badge bg-success">Configurado</span> tiene cuentas asignadas,
                                        <span class="badge bg-warning">Sin configurar</span> necesita cuentas</li>
                                    <li><strong>Configurar:</strong> Use la pestaña "Configurar nodo" para editar un concepto+columna</li>
                                    <li><strong>Dominio:</strong> Aplique filtros personalizados por concepto</li>
                                    <li><strong>Sincronizar:</strong> Envíe la configuración al format_setting para generar el reporte</li>
                                </ol>
                                <hr/>
                                <h5>Acciones masivas</h5>
                                <ul>
                                    <li><strong><i class="fa fa-magic"/> Sugerir todos:</strong> Aplica patrones PUC predefinidos a todos los conceptos</li>
                                    <li><strong><i class="fa fa-download"/> Cargar cuentas:</strong> Resuelve los patrones (ej: 5105%) a cuentas reales</li>
                                    <li><strong><i class="fa fa-upload"/> Sincronizar:</strong> Crea las setting_lines en la configuración del formato</li>
                                </ul>
                            </div>
                        </group>
                    </page>
                </notebook>

                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_co_exogenous_concept_plan_wizard" model="ir.actions.act_window">
        <field name="name">Plan de conceptos</field>
        <field name="res_model">l10n_co.exogenous_concept_plan_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
