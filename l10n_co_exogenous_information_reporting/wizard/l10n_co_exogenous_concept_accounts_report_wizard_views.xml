<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_co_exogenous_concept_accounts_report_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.concept.accounts.report.wizard.form</field>
        <field name="model">l10n_co.exogenous_concept_accounts_report_wizard</field>
        <field name="arch" type="xml">
            <form string="Informe de conceptos y cuentas asociadas">
                <header>
                    <button name="action_generate_report"
                            string="Consultar"
                            type="object"
                            class="btn-primary"
                            icon="fa-search"/>
                    <button name="action_export_excel"
                            string="Excel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-excel-o"/>
                </header>
                <sheet>
                    <group>
                        <group string="Filtros">
                            <field name="format_id"
                                   options="{'no_create': True}"
                                   placeholder="Todos los reportes"/>
                            <field name="format_field_filter_id"
                                   options="{'no_create': True}"
                                   placeholder="Todas las columnas"
                                   domain="[('format_ids', 'in', format_id), ('source', '=', 'journal_items')]" invisible="format_id == False"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Opciones">
                            <field name="detail_columns"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resultados" name="results">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list string="Cuentas por concepto"
                                      decoration-info="header_display"
                                      default_order="header_display, account_code">
                                    <field name="header_display" invisible="1"/>
                                    <field name="account_code" string="Cuenta contable"/>
                                    <field name="account_name" string="Nombre cuenta"/>
                                    <field name="column_name" string="Columna reporte" optional="show"/>
                                    <field name="nature_account" string="Fórmula DIAN" optional="show"/>
                                    <field name="concept_code" string="Concepto" optional="show"/>
                                    <field name="concept_name" string="Nombre concepto" optional="show"/>
                                    <field name="format_id" optional="hide"/>
                                    <field name="format_field_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group invisible="binary_file == False">
                        <field name="binary_file" filename="binary_file_name" readonly="1"/>
                        <field name="binary_file_name" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_co_exogenous_concept_accounts_report_wizard" model="ir.actions.act_window">
        <field name="name">Conceptos y cuentas asociadas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_co.exogenous_concept_accounts_report_wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="l10n_co_exogenous_concept_accounts_report_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generar informe de conceptos y cuentas asociadas
            </p>
            <p>
                Este informe muestra todas las cuentas contables asociadas a cada concepto
                configurado en los formatos de información exógena.
            </p>
        </field>
    </record>

</odoo>
