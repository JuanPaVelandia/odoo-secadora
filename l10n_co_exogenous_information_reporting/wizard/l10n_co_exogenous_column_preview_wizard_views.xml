<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_co_exogenous_column_preview_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.column.preview.wizard.form</field>
        <field name="model">l10n_co.exogenous_column_preview_wizard</field>
        <field name="arch" type="xml">
            <form string="Preview de columnas">
                <sheet>
                    <field name="preview_html" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
