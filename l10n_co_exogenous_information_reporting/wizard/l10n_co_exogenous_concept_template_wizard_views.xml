<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_co_exogenous_concept_template_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.concept.template.wizard.form</field>
        <field name="model">l10n_co.exogenous_concept_template_wizard</field>
        <field name="arch" type="xml">
            <form string="Plantilla de conceptos">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong><i class="fa fa-info-circle"/> Plantilla de conceptos exógena.</strong>
                        Use la pestaña <em>Exportar</em> para generar un Excel listo para llenar y la
                        pestaña <em>Importar</em> para cargarlo de vuelta. La hoja "Instrucciones" del
                        archivo explica cada columna y los códigos válidos de naturaleza.
                    </div>

                    <group>
                        <group string="Parámetros generales">
                            <field name="format_id" options="{'no_create': True}"/>
                            <field name="apply_concepts" invisible="1"/>
                            <field name="journal_type"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Opciones de export">
                            <field name="include_existing"/>
                            <field name="include_examples"
                                   invisible="include_existing == True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Exportar plantilla" name="export">
                            <group>
                                <field name="column_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('format_ids', 'in', format_id), ('source', '=', 'journal_items')]"
                                       invisible="format_id == False"/>
                            </group>
                            <div class="text-muted mb-2">
                                <i class="fa fa-lightbulb-o"/>
                                Si deja "Columnas a incluir" vacío al pulsar Exportar, se incluirán todas
                                las columnas del formato (source = journal_items).
                            </div>
                            <footer class="d-flex">
                                <button name="action_export_template"
                                        type="object"
                                        string="Generar y descargar plantilla"
                                        class="btn-primary"
                                        icon="fa-download"
                                        invisible="format_id == False"/>
                            </footer>
                            <group invisible="binary_file == False">
                                <field name="binary_file_name" readonly="1"/>
                                <field name="binary_file"
                                       filename="binary_file_name"
                                       readonly="1"/>
                            </group>
                        </page>

                        <page string="Importar plantilla" name="import">
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-warning"/>
                                Antes de importar, asegúrese de que el <strong>Formato</strong> y la
                                <strong>Compañía</strong> arriba son los correctos. Los conceptos se
                                identifican por el par <em>(Código, Formato, Compañía)</em>.
                            </div>
                            <group>
                                <field name="import_file_name" invisible="1"/>
                                <field name="import_file" filename="import_file_name"/>
                            </group>
                            <footer class="d-flex">
                                <button name="action_import_template"
                                        type="object"
                                        string="Importar plantilla"
                                        class="btn-primary"
                                        icon="fa-upload"
                                        invisible="format_id == False or import_file == False"/>
                            </footer>
                            <group string="Resumen del último import"
                                   invisible="import_summary == False">
                                <field name="import_summary" nolabel="1" readonly="1"
                                       widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_co_exogenous_concept_template_wizard" model="ir.actions.act_window">
        <field name="name">Plantilla de conceptos (export/import)</field>
        <field name="res_model">l10n_co.exogenous_concept_template_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
