<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_co_exogenous_audit_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.audit.wizard.form</field>
        <field name="model">l10n_co.exogenous_audit_wizard</field>
        <field name="arch" type="xml">
            <form string="Auditoría de configuración">
                <header>
                    <button name="action_run_audit"
                            string="Auditar"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                    <button name="action_export_excel"
                            string="Exportar Excel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-excel-o" invisible="column_line_ids == False"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Auditoría formato </span>
                            <field name="format_id" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="audit_result != 'ok'">
                        <strong>Configuración válida.</strong> No se encontraron problemas.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="audit_result != 'warning'">
                        <strong>Advertencias encontradas.</strong> Revise la pestaña "Problemas".
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="audit_result != 'error'">
                        <strong>Errores encontrados.</strong> Corrija los problemas antes de generar el reporte.
                    </div>
                    <group invisible="column_line_ids == False">
                        <group string="Resumen">
                            <field name="total_columns"/>
                            <field name="total_fixed"/>
                            <field name="total_value"/>
                        </group>
                        <group string="Estado">
                            <field name="total_concepts" invisible="total_concepts == 0"/>
                            <field name="total_accounts"/>
                            <field name="total_issues"/>
                            <field name="total_warnings"/>
                            <field name="audit_result" widget="badge"
                                   decoration-success="audit_result == 'ok'"
                                   decoration-warning="audit_result == 'warning'"
                                   decoration-danger="audit_result == 'error'"/>
                        </group>
                    </group>
                    <field name="format_setting_id" invisible="1"/>
                    <notebook invisible="column_line_ids == False">
                        <page string="Columnas del reporte" name="columns">
                            <field name="column_line_ids" nolabel="1" readonly="1">
                                <list string="Columnas"
                                      decoration-danger="xsd_status == 'missing_attr'"
                                      decoration-warning="xsd_status == 'extra'"
                                      decoration-success="xsd_status == 'ok'">
                                    <field name="sequence" string="Orden"/>
                                    <field name="field_type_display" string="Tipo"/>
                                    <field name="field_name" string="Nombre columna"/>
                                    <field name="attribute" string="Atributo XSD"/>
                                    <field name="xsd_type" string="Tipo XSD" optional="show"/>
                                    <field name="xsd_required" string="Requerido" optional="show"/>
                                    <field name="max_length" string="Long. Máx" optional="show"/>
                                    <field name="account_count" string="No. Cuentas"/>
                                    <field name="corte" string="Corte" optional="show"/>
                                    <field name="nature" string="Fórmula" optional="show"/>
                                    <field name="applies_smaller" string="Cuantía" optional="show"/>
                                    <field name="principal_ref" string="Principal" optional="show"/>
                                    <field name="default_value" string="Defecto" optional="hide"/>
                                    <field name="xsd_info" string="Estado"/>
                                    <field name="xsd_status" invisible="1"/>
                                    <field name="field_type" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Problemas" name="issues">
                            <field name="issue_line_ids" nolabel="1" readonly="1">
                                <list string="Problemas detectados"
                                      decoration-danger="severity == 'error'"
                                      decoration-warning="severity == 'warning'">
                                    <field name="severity" string="Severidad" widget="badge"
                                           decoration-danger="severity == 'error'"
                                           decoration-warning="severity == 'warning'"/>
                                    <field name="category" string="Categoría"/>
                                    <field name="message" string="Descripción"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group invisible="binary_file == False">
                        <field name="binary_file" filename="binary_file_name" readonly="1"/>
                        <field name="binary_file_name" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
