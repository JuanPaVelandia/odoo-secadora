<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_l10n_co_exogenous_replicate_wizard_form" model="ir.ui.view">
            <field name="name">l10n_co.exogenous_replicate_wizard.form</field>
            <field name="model">l10n_co.exogenous_replicate_wizard</field>
            <field name="arch" type="xml">
                <form string="Replicar conceptos y retenciones">
                    <sheet>
                        <group>
                            <group>
                                <field name="source_company_id" options="{'no_create': True}"/>
                                <field name="target_company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="replicate_concepts"/>
                                <field name="replicate_retentions"/>
                                <field name="replicate_certificate_configs"/>
                                <field name="replicate_income_cert_configs"/>
                                <field name="overwrite"/>
                                <field name="dry_run"/>
                            </group>
                        </group>
                        <group string="Resultado" invisible="result_log == False">
                            <field name="result_log" nolabel="1" readonly="1" widget="text"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_run" string="Ejecutar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_l10n_co_exogenous_replicate_wizard" model="ir.actions.act_window">
            <field name="name">Replicar conceptos y retenciones a otras compañías</field>
            <field name="res_model">l10n_co.exogenous_replicate_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_source_company_id': active_id}</field>
        </record>
    </data>
</odoo>
