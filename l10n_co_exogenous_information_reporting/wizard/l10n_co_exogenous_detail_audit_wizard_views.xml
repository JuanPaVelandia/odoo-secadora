<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="l10n_co_exogenous_detail_audit_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n.co.exogenous.detail.audit.wizard.form</field>
        <field name="model">l10n_co.exogenous_detail_audit_wizard</field>
        <field name="arch" type="xml">
            <form string="Auxiliar detallado">
                <header>
                    <button name="action_generate_detail"
                            string="Generar auxiliar"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"/>
                    <button name="action_export_excel"
                            string="Exportar Excel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-excel-o" invisible="total_lines == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Auxiliar detallado - </span>
                            <field name="format_id" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <group invisible="total_lines == 0">
                        <group string="Totales generales">
                            <field name="total_lines"/>
                            <field name="total_debit"/>
                            <field name="total_credit"/>
                            <field name="total_formula"/>
                        </group>
                    </group>
                    <field name="format_setting_id" invisible="1"/>
                    <notebook invisible="total_lines == 0">
                        <page string="Resumen por concepto" name="summary">
                            <field name="summary_line_ids" nolabel="1" readonly="1">
                                <list string="Resumen por concepto/columna">
                                    <field name="concept_code" string="Concepto"/>
                                    <field name="concept_name" string="Nombre" optional="show"/>
                                    <field name="field_name" string="Columna"/>
                                    <field name="formula" string="Fórmula"/>
                                    <field name="total_debit" string="Total débito" sum="Total"/>
                                    <field name="total_credit" string="Total crédito" sum="Total"/>
                                    <field name="total_formula" string="Total fórmula" sum="Total"/>
                                    <field name="line_count" string="Líneas" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Auxiliar detallado" name="detail">
                            <field name="detail_line_ids" nolabel="1" readonly="1">
                                <list string="Detalle de líneas de movimiento"
                                      default_order="concept_code, field_name, date">
                                    <field name="concept_code" string="Concepto"
                                           optional="show"/>
                                    <field name="field_name" string="Columna"/>
                                    <field name="account_display" string="Cuenta"/>
                                    <field name="partner_display" string="Tercero"/>
                                    <field name="date" string="Fecha"/>
                                    <field name="move_display" string="Asiento"/>
                                    <field name="debit" string="Débito" sum="Total"/>
                                    <field name="credit" string="Crédito" sum="Total"/>
                                    <field name="formula_type" string="Fórmula"
                                           optional="show"/>
                                    <field name="formula_value" string="Valor"
                                           sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group invisible="binary_file == False">
                        <field name="binary_file" filename="binary_file_name" readonly="1"/>
                        <field name="binary_file_name" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
