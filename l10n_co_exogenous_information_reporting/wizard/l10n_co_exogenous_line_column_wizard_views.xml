<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_co_exogenous_line_column_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_co.exogenous_line_column_wizard.form</field>
        <field name="model">l10n_co.exogenous_line_column_wizard</field>
        <field name="arch" type="xml">
            <form string="Ubicar líneas en columnas del 1001">
                <sheet>
                    <group>
                        <group string="Cabecera (aplicable en bloque)">
                            <field name="format_id" options="{'no_create': True}"/>
                            <field name="concept_id" options="{'no_create': True}"/>
                            <field name="target_column"/>
                            <field name="target_percentage" invisible="target_column == False"/>
                            <field name="secondary_column" invisible="target_column == False or target_percentage &gt;= 100" required="target_column != False and target_percentage &lt; 100"/>
                        </group>
                        <group string="Acciones en bloque">
                            <button name="action_apply_header_to_selected" type="object"
                                    string="Propagar cabecera a seleccionadas" class="btn-secondary"
                                    icon="fa-arrow-down"/>
                            <button name="action_reapply_detection" type="object"
                                    string="Re-detectar automático" class="btn-secondary"
                                    icon="fa-refresh"/>
                            <button name="action_select_all" type="object"
                                    string="Seleccionar todas" class="btn-link"/>
                            <button name="action_unselect_all" type="object"
                                    string="Deseleccionar todas" class="btn-link"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="selected" widget="boolean_toggle"/>
                                    <field name="date" readonly="1"/>
                                    <field name="partner_id" readonly="1" optional="show"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="tax_line_id" readonly="1" optional="hide"/>
                                    <field name="debit" readonly="1" sum="Débito"/>
                                    <field name="credit" readonly="1" sum="Crédito"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="suggested_column" readonly="1"
                                           decoration-info="suggested_column in ('pago','pnded')"
                                           decoration-warning="suggested_column in ('ided','inded')"
                                           decoration-success="suggested_column in ('retp','reta','comun','ndom')"/>
                                    <field name="target_column"/>
                                    <field name="target_percentage"/>
                                    <field name="secondary_column" invisible="target_percentage >= 100"/>
                                    <field name="reason" optional="show"/>
                                    <field name="move_line_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar"
                            class="btn-primary" icon="fa-check"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_co_exogenous_line_column_wizard_action" model="ir.actions.act_window">
        <field name="name">Ubicar en columna 1001</field>
        <field name="res_model">l10n_co.exogenous_line_column_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
