<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="l10n_co_exogenous.ConceptPlan" owl="1">
    <div class="o_action o_exogenous_concept_plan p-3">
        <!-- Header -->
        <div class="d-flex align-items-center mb-4">
            <div class="flex-grow-1">
                <h2 class="mb-1 fw-bold" style="color: #8b5cf6;">
                    <i class="fa fa-sitemap me-2"/>Plan de Conceptos y Cuentas
                </h2>
                <p class="text-muted mb-0">Configuración jerárquica — Conceptos, columnas, cuentas y dominios</p>
            </div>
        </div>

        <!-- Controls -->
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <label class="form-label fw-bold">Formato</label>
                <select class="form-select" t-on-change="onFormatChange">
                    <option value="">— Seleccionar formato —</option>
                    <t t-foreach="state.formats" t-as="fmt" t-key="fmt.id">
                        <option t-att-value="fmt.id" t-att-selected="state.selectedFormatId === fmt.id">
                            [<t t-esc="fmt.code"/>] <t t-esc="fmt.name"/>
                        </option>
                    </t>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button class="btn btn-primary"
                        t-on-click="onBuildTree"
                        t-att-disabled="!state.selectedFormatId or state.loading">
                    <i class="fa fa-sitemap me-1"/>
                    <t t-if="state.loading">Cargando...</t>
                    <t t-else="">Construir árbol</t>
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                        t-on-click="onExpandAll"
                        t-att-disabled="state.treeData.length === 0" title="Expandir todo">
                    <i class="fa fa-expand"/>
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                        t-on-click="onCollapseAll"
                        t-att-disabled="state.treeData.length === 0" title="Colapsar todo">
                    <i class="fa fa-compress"/>
                </button>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-1 flex-wrap">
                <button class="btn btn-warning btn-sm"
                        t-on-click="onSuggestAll"
                        t-att-disabled="state.treeData.length === 0" title="Sugerir patrones para todos">
                    <i class="fa fa-magic me-1"/>Sugerir
                </button>
                <button class="btn btn-info btn-sm"
                        t-on-click="onLoadAllPatterns"
                        t-att-disabled="state.treeData.length === 0" title="Cargar cuentas desde patrones">
                    <i class="fa fa-download me-1"/>Cargar
                </button>
                <button class="btn btn-success btn-sm"
                        t-on-click="onSyncToSetting"
                        t-att-disabled="!state.selectedSettingId" title="Sincronizar con configuración">
                    <i class="fa fa-upload me-1"/>Sync
                </button>
            </div>
        </div>

        <!-- KPI Cards -->
        <t t-if="state.treeData.length > 0">
            <div class="row g-3 mb-4">
                <div class="col-3">
                    <div class="card border-0 shadow-sm bg-primary">
                        <div class="card-body text-white text-center py-2">
                            <div class="h3 mb-0 fw-bold"><t t-esc="state.kpis.concepts"/></div>
                            <small class="fw-semibold">Conceptos</small>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-0 shadow-sm bg-info">
                        <div class="card-body text-white text-center py-2">
                            <div class="h3 mb-0 fw-bold"><t t-esc="state.kpis.columns"/></div>
                            <small class="fw-semibold">Columnas</small>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-0 shadow-sm bg-success">
                        <div class="card-body text-white text-center py-2">
                            <div class="h3 mb-0 fw-bold"><t t-esc="state.kpis.configured"/></div>
                            <small class="fw-semibold">Configurados</small>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-0 shadow-sm bg-warning">
                        <div class="card-body text-white text-center py-2">
                            <div class="h3 mb-0 fw-bold"><t t-esc="state.kpis.accounts"/></div>
                            <small class="fw-semibold">Cuentas</small>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- Main Content: Split View -->
        <div class="row g-3">
            <!-- LEFT: Tree -->
            <div t-att-class="state.selectedNode ? 'col-md-7' : 'col-md-12'">
                <t t-if="state.loading">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"/>
                        <p class="mt-2 text-muted">Construyendo árbol de conceptos...</p>
                    </div>
                </t>

                <t t-elif="state.treeData.length === 0">
                    <div class="text-center py-5">
                        <i class="fa fa-sitemap fa-3x text-muted mb-3 d-block"/>
                        <p class="text-muted">Seleccione un formato y haga clic en "Construir árbol"</p>
                    </div>
                </t>

                <t t-else="">
                    <div class="border rounded" style="max-height: 600px; overflow-y: auto;">
                        <t t-foreach="concepts" t-as="concept" t-key="concept.concept_id">
                            <!-- Concept Node -->
                            <div class="d-flex align-items-center px-3 py-2 border-bottom cursor-pointer bg-light"
                                 t-on-click="() => this.onToggleConcept(concept.concept_id)">
                                <i t-att-class="'fa me-2 ' + (isExpandedConcept(concept.concept_id) ? 'fa-folder-open text-warning' : 'fa-folder text-secondary')"/>
                                <span class="fw-bold flex-grow-1">
                                    <span class="badge bg-primary me-1"><t t-esc="concept.concept_code"/></span>
                                    <t t-esc="concept.concept_name"/>
                                </span>
                                <span t-if="concept.configured_count > 0"
                                      class="badge bg-success me-1" title="Columnas configuradas">
                                    <t t-esc="concept.configured_count"/>/<t t-esc="concept.total_columns"/>
                                </span>
                                <span t-else="" class="badge bg-warning text-dark me-1">sin config.</span>
                                <i t-att-class="'fa fa-chevron-' + (isExpandedConcept(concept.concept_id) ? 'down' : 'right') + ' text-muted'"/>
                            </div>

                            <!-- Column Nodes (children) -->
                            <t t-if="isExpandedConcept(concept.concept_id)">
                                <t t-foreach="getColumns(concept.concept_id)" t-as="col" t-key="col.field_id">
                                    <div class="d-flex align-items-center px-3 py-2 border-bottom cursor-pointer"
                                         t-att-class="isNodeSelected(col) ? 'bg-secondary bg-opacity-25 border-start border-3 border-dark' : ''"
                                         style="padding-left: 2.5rem !important;"
                                         t-on-click="() => this.onSelectNode(col.concept_id, col.field_id)">
                                        <i t-att-class="'fa me-2 ' + (col.account_count > 0 ? 'fa-check-circle text-success' : 'fa-circle-o text-muted')"/>
                                        <span class="flex-grow-1">
                                            <t t-esc="col.field_name"/>
                                        </span>
                                        <span class="badge bg-light text-dark me-1" title="Fórmula">
                                            <t t-esc="col.nature || 'db_cr'"/>
                                        </span>
                                        <span t-if="col.pattern" class="text-muted small me-1" title="Patrón">
                                            <i class="fa fa-filter"/> <t t-esc="col.pattern"/>
                                        </span>
                                        <span class="badge" t-att-class="col.account_count > 0 ? 'bg-success' : 'bg-secondary'">
                                            <t t-esc="col.account_count"/> ctas
                                        </span>
                                    </div>
                                </t>
                            </t>
                        </t>
                    </div>
                </t>
            </div>

            <!-- RIGHT: Detail Panel -->
            <t t-if="state.selectedNode">
                <div class="col-md-5">
                    <div class="card shadow-sm border-0 sticky-top" style="top: 1rem;">
                        <div class="card-header bg-dark text-white d-flex align-items-center">
                            <i class="fa fa-cog me-2 text-white"/>
                            <strong>Configurar nodo</strong>
                            <button class="btn btn-sm btn-link ms-auto text-white" t-on-click="onClosePanel">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <div class="card-body bg-light">
                            <!-- Node info -->
                            <div class="mb-3">
                                <small class="text-muted">Concepto</small>
                                <div class="fw-bold">
                                    <span class="badge bg-primary me-1"><t t-esc="state.selectedNode.concept_code"/></span>
                                    <t t-esc="state.selectedNode.concept_name"/>
                                </div>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted">Columna</small>
                                <div class="fw-bold"><t t-esc="state.selectedNode.field_name"/></div>
                            </div>

                            <hr/>

                            <!-- Pattern -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Patrón de cuentas</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Ej: 5105%, 5110%, 2365%"
                                       t-att-value="state.detailPattern"
                                       t-on-input="onPatternInput"/>
                            </div>

                            <!-- Nature -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Fórmula DIAN</label>
                                <select class="form-select form-select-sm" t-on-change="onNatureChange">
                                    <t t-foreach="natureOptions" t-as="opt" t-key="opt.value">
                                        <option t-att-value="opt.value"
                                                t-att-selected="state.detailNature === opt.value">
                                            <t t-esc="opt.label"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <!-- Move type filter -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tipo de movimiento</label>
                                <select class="form-select form-select-sm" t-on-change="onMoveTypeChange">
                                    <option value="all"          t-att-selected="state.detailMoveType === 'all'">Todos</option>
                                    <option value="entry"        t-att-selected="state.detailMoveType === 'entry'">Asientos</option>
                                    <option value="out_invoice"  t-att-selected="state.detailMoveType === 'out_invoice'">Facturas venta</option>
                                    <option value="in_invoice"   t-att-selected="state.detailMoveType === 'in_invoice'">Facturas compra</option>
                                </select>
                            </div>

                            <!-- Tax filter -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Filtro de impuesto</label>
                                <select class="form-select form-select-sm" t-on-change="onTaxFilterChange">
                                    <option value="all"             t-att-selected="state.detailTaxFilter === 'all'">Todas las líneas</option>
                                    <option value="tax_lines_only"  t-att-selected="state.detailTaxFilter === 'tax_lines_only'">Solo líneas impuesto</option>
                                    <option value="base_lines_only" t-att-selected="state.detailTaxFilter === 'base_lines_only'">Solo líneas base</option>
                                </select>
                            </div>

                            <!-- Custom domain -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Dominio personalizado</label>
                                <textarea class="form-control form-control-sm font-monospace" rows="3"
                                          placeholder="[('campo', 'operador', 'valor')]"
                                          t-on-input="onDomainInput"><t t-esc="state.detailDomain"/></textarea>
                                <button class="btn btn-outline-secondary btn-sm mt-1" t-on-click="onTestDomain">
                                    <i class="fa fa-check me-1"/>Probar
                                </button>
                            </div>

                            <hr/>

                            <!-- Apply button -->
                            <button class="btn btn-primary w-100" t-on-click="onApplyNodeConfig">
                                <i class="fa fa-save me-1"/>Aplicar configuración
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </div>
</t>

</templates>
