            />
            <field name="active" eval="True"/>
            <field name="is_unique_key" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Código CIIU (para Medellín, Barranquilla) -->
        <record id="l10n_co_district_format_field_cod_ciiu" model="l10n_co.exogenous_format_field">
            <field name="name">Código CIIU</field>
            <field name="sequence" eval="90"/>
            <field name="max_length" eval="6"/>
            <field name="attribute">codCIIU</field>
            <field name="source">resolution</field>
            <field name="format_ids" eval="[
