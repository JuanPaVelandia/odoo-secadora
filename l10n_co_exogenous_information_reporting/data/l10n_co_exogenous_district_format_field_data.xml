        <record id="l10n_co_district_format_field_ano_gravable" model="l10n_co.exogenous_format_field">
            <field name="name">Año gravable</field>
            <field name="sequence" eval="5"/>
            <field name="max_length" eval="4"/>
            <field name="attribute">anoGravable</field>
            <field name="source">resolution</field>
            <field name="format_ids" eval="[
