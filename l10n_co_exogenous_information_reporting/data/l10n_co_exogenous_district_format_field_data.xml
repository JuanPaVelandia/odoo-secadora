<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Campos de formato para exógena distrital.
            Se vinculan los campos comunes existentes (tdoc, nid, dv, razon social, etc.)
            a los formatos distritales, y se crean campos específicos nuevos.
        -->

        <!-- ========== Vincular campos comunes existentes a formatos distritales ========== -->
        <!-- Concepto (cpt) -->
        <record id="l10n_co_exogenous_format_field_cpt" model="l10n_co.exogenous_format_field">
            <field name="format_ids" eval="[
                (4, ref('l10n_co_exogenous_district_format_bog_2001')),
                (4, ref('l10n_co_exogenous_district_format_bog_2002')),
                (4, ref('l10n_co_exogenous_district_format_bog_2003')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_med_3002')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5002')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4002')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6002')),
                (4, ref('l10n_co_exogenous_district_format_per_7001')),
                (4, ref('l10n_co_exogenous_district_format_per_7002'))]"
            />
        </record>

        <!-- Tipo de documento (tdoc) -->
        <record id="l10n_co_exogenous_format_field_tdoc" model="l10n_co.exogenous_format_field">
            <field name="format_ids" eval="[
                (4, ref('l10n_co_exogenous_district_format_bog_2001')),
                (4, ref('l10n_co_exogenous_district_format_bog_2002')),
                (4, ref('l10n_co_exogenous_district_format_bog_2003')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_med_3002')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5002')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4002')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6002')),
                (4, ref('l10n_co_exogenous_district_format_per_7001')),
                (4, ref('l10n_co_exogenous_district_format_per_7002'))]"
            />
        </record>

        <!-- Número de identificación (nid) -->
        <record id="l10n_co_exogenous_format_field_nid" model="l10n_co.exogenous_format_field">
            <field name="format_ids" eval="[
                (4, ref('l10n_co_exogenous_district_format_bog_2001')),
                (4, ref('l10n_co_exogenous_district_format_bog_2002')),
                (4, ref('l10n_co_exogenous_district_format_bog_2003')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_med_3002')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5002')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4002')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6002')),
                (4, ref('l10n_co_exogenous_district_format_per_7001')),
                (4, ref('l10n_co_exogenous_district_format_per_7002'))]"
            />
        </record>

        <!-- ========== Campos específicos distritales ========== -->

        <!-- Valor compra / pago (campo journal_items para acumulado) -->
        <record id="l10n_co_district_format_field_vlr_compra" model="l10n_co.exogenous_format_field">
            <field name="name">Valor compra / pago</field>
            <field name="sequence" eval="100"/>
            <field name="max_length" eval="20"/>
            <field name="attribute">vlrCompra</field>
            <field name="source">journal_items</field>
            <field name="format_ids" eval="[
                (5, 0, 0),
                (4, ref('l10n_co_exogenous_district_format_bog_2001')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_per_7001'))]"
            />
            <field name="active" eval="True"/>
            <field name="is_unique_key" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Valor retención ICA practicada -->
        <record id="l10n_co_district_format_field_vlr_rete_ica" model="l10n_co.exogenous_format_field">
            <field name="name">Valor retención ICA practicada</field>
            <field name="sequence" eval="110"/>
            <field name="max_length" eval="20"/>
            <field name="attribute">vlrReteICA</field>
            <field name="source">journal_items</field>
            <field name="format_ids" eval="[
                (5, 0, 0),
                (4, ref('l10n_co_exogenous_district_format_bog_2001')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_per_7001'))]"
            />
            <field name="active" eval="True"/>
            <field name="is_unique_key" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Valor ingreso bruto -->
        <record id="l10n_co_district_format_field_vlr_ingreso" model="l10n_co.exogenous_format_field">
            <field name="name">Valor ingreso bruto</field>
            <field name="sequence" eval="100"/>
            <field name="max_length" eval="20"/>
            <field name="attribute">vlrIngreso</field>
            <field name="source">journal_items</field>
            <field name="format_ids" eval="[
