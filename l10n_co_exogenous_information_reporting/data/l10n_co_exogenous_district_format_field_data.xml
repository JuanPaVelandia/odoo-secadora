                (4, ref('l10n_co_exogenous_district_format_ctg_6002')),
                (4, ref('l10n_co_exogenous_district_format_per_7002'))]"
            />
            <field name="active" eval="True"/>
            <field name="is_unique_key" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Valor retención ICA que le practicaron -->
        <record id="l10n_co_district_format_field_vlr_rete_recibida" model="l10n_co.exogenous_format_field">
            <field name="name">Valor retención ICA recibida</field>
            <field name="sequence" eval="110"/>
            <field name="max_length" eval="20"/>
            <field name="attribute">vlrReteRecibida</field>
            <field name="source">journal_items</field>
            <field name="format_ids" eval="[
                (5, 0, 0),
                (4, ref('l10n_co_exogenous_district_format_bog_2003'))]"
            />
            <field name="active" eval="True"/>
            <field name="is_unique_key" eval="False"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Valor devoluciones -->
        <record id="l10n_co_district_format_field_vlr_devolucion" model="l10n_co.exogenous_format_field">
            <field name="name">Valor devoluciones</field>
            <field name="sequence" eval="120"/>
            <field name="max_length" eval="20"/>
            <field name="attribute">vlrDevolucion</field>
            <field name="source">journal_items</field>
            <field name="format_ids" eval="[
