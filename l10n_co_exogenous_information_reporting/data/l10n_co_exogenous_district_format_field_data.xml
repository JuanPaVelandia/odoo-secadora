                (4, ref('l10n_co_exogenous_district_format_bog_2002')),
                (4, ref('l10n_co_exogenous_district_format_bog_2003')),
                (4, ref('l10n_co_exogenous_district_format_med_3001')),
                (4, ref('l10n_co_exogenous_district_format_med_3002')),
                (4, ref('l10n_co_exogenous_district_format_cali_5001')),
                (4, ref('l10n_co_exogenous_district_format_cali_5002')),
                (4, ref('l10n_co_exogenous_district_format_baq_4001')),
                (4, ref('l10n_co_exogenous_district_format_baq_4002')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6001')),
                (4, ref('l10n_co_exogenous_district_format_ctg_6002')),
                (4, ref('l10n_co_exogenous_district_format_per_7001')),
