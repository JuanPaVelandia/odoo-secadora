            <field name="max_field_length">0</field>
            <field name="document_type_table_id" ref="l10n_co_exogenous_district_doc_type_table_medellin"/>
            <field name="notes">Exógena municipal ICA Medellín - Secretaría de Hacienda Municipal. Formato CSV con delimitador coma. Conceptos por actividad CIIU.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

