<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ===================== 6 Ciudades principales ===================== -->

        <!-- Bogotá D.C. -->
        <record id="l10n_co_exogenous_district_bogota" model="l10n_co.exogenous_district">
            <field name="name">Bogotá D.C.</field>
            <field name="code">11001</field>
            <field name="department">Bogotá</field>
            <field name="department_code">11</field>
            <field name="delimiter">pipe</field>
            <field name="file_extension">txt</field>
            <field name="include_header" eval="True"/>
            <field name="text_encoding">windows-1252</field>
            <field name="sanitize_text" eval="True"/>
            <field name="max_field_length">200</field>
            <field name="document_type_table_id" ref="l10n_co_exogenous_district_doc_type_table_bogota"/>
            <field name="notes">Exógena distrital ICA Bogotá - Secretaría de Hacienda Distrital. Formato con delimitador pipe (|). Resolución SHD aplicable vigencia fiscal.</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Medellín -->
        <record id="l10n_co_exogenous_district_medellin" model="l10n_co.exogenous_district">
