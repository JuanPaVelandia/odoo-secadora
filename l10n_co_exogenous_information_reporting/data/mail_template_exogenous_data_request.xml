<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Plantilla de correo: Solicitud de datos para información exógena -->
        <record id="mail_template_exogenous_data_request" model="mail.template">
            <field name="name">Exógena: Solicitud de actualización de datos</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Solicitud de actualización de datos — Información Exógena</field>
            <field name="email_from">{{ object.company_id.email or user.email }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif;">
    <table width="600" cellpadding="0" cellspacing="0" style="margin: 0 auto; background: #ffffff; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
        <!-- Header -->
        <tr>
            <td style="background: linear-gradient(135deg, #3b82f6, #1d4ed8); padding: 30px; text-align: center;">
                <h2 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: 700;">
                    Actualización de datos
                </h2>
                <p style="color: #dbeafe; margin: 8px 0 0; font-size: 14px;">
                    Información exógena DIAN
                </p>
            </td>
        </tr>
        <!-- Body -->
        <tr>
            <td style="padding: 30px;">
                <p style="font-size: 15px; color: #374151; line-height: 1.6;">
                    Estimado(a) <strong>{{ object.name }}</strong>,
                </p>
                <p style="font-size: 15px; color: #374151; line-height: 1.6;">
                    Nos dirigimos a usted con el fin de solicitar la actualización de sus datos
                    para el cumplimiento de las obligaciones de información exógena ante la
                    <strong>Dirección de Impuestos y Aduanas Nacionales (DIAN)</strong>.
                </p>
                <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin: 20px 0; border-radius: 0 4px 4px 0;">
                    <p style="margin: 0; font-size: 14px; color: #92400e;">
                        <strong>Importante:</strong> La información solicitada es necesaria para el
                        reporte de medios magnéticos y debe coincidir con los datos registrados
                        ante la DIAN (RUT).
                    </p>
                </div>
                <p style="font-size: 15px; color: #374151; line-height: 1.6;">
                    Le solicitamos amablemente que nos proporcione y/o actualice la siguiente información:
                </p>
                <table width="100%" cellpadding="8" cellspacing="0" style="border: 1px solid #e5e7eb; border-radius: 4px; margin: 15px 0;">
                    <tr style="background: #f3f4f6;">
                        <td style="border-bottom: 1px solid #e5e7eb; font-weight: bold; font-size: 14px; color: #374151;" width="40%">Dato</td>
                        <td style="border-bottom: 1px solid #e5e7eb; font-weight: bold; font-size: 14px; color: #374151;">Información actual</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">NIT / C.C.</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.vat or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Tipo de documento</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.l10n_latam_identification_type_id.name or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Razón social / Nombre</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.name or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Dirección</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.street or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Ciudad</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ (object.city_id and object.city_id.name) or object.city or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Departamento</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.state_id.name or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">País</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.country_id.name or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px; color: #6b7280;">Correo electrónico</td>
                        <td style="border-bottom: 1px solid #f3f4f6; font-size: 14px;">{{ object.email or 'Sin registrar' }}</td>
                    </tr>
                    <tr>
                        <td style="font-size: 14px; color: #6b7280;">Teléfono</td>
                        <td style="font-size: 14px;">{{ object.phone or object.mobile or 'Sin registrar' }}</td>
                    </tr>
                </table>
                <p style="font-size: 15px; color: #374151; line-height: 1.6;">
                    Si alguno de estos datos no es correcto o se encuentra incompleto, le
                    agradecemos responder este correo con la información actualizada a la
                    mayor brevedad.
                </p>
                <p style="font-size: 15px; color: #374151; line-height: 1.6;">
                    Agradecemos su pronta respuesta.
                </p>
                <p style="font-size: 15px; color: #374151; margin-top: 25px;">
                    Cordialmente,<br/>
                    <strong>{{ object.company_id.name or user.company_id.name }}</strong><br/>
                    <span style="color: #6b7280; font-size: 13px;">Departamento Contable</span>
                </p>
            </td>
        </tr>
        <!-- Footer -->
        <tr>
            <td style="background: #f9fafb; padding: 20px; text-align: center; border-top: 1px solid #e5e7eb;">
                <p style="font-size: 12px; color: #9ca3af; margin: 0;">
                    Este correo fue generado automáticamente por el módulo de Información Exógena.
                    Por favor no responda a esta dirección si no tiene datos para actualizar.
                </p>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

    </data>
</odoo>
