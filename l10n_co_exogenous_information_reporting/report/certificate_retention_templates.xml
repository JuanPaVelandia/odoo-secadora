<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="cert_retention">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="cert">
                    <t t-if="cert.get('report_style', 'classic') == 'modern'">
                        <t t-call="l10n_co_exogenous_information_reporting.cert_retention_modern"/>
                    </t>
                    <t t-else="">
                        <t t-call="l10n_co_exogenous_information_reporting.cert_retention_classic"/>
                    </t>
                </t>
            </t>
        </template>

        <template id="cert_retention_classic">
            <t t-call="web.basic_layout">
                <head>
                    <style>
                        @page { size: letter; margin: 20mm 18mm 22mm 18mm; }
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                            font-size: 11px;
                            color: #212529;
                            line-height: 1.5;
                        }
                        .o_cert_header { border-bottom: 2px solid #714B67; padding-bottom: 12px; margin-bottom: 18px; }
                        .o_cert_company { font-size: 15px; font-weight: 600; color: #212529; margin: 0; }
                        .o_cert_subtitle { font-size: 10px; color: #6c757d; margin: 2px 0 0; }
                        .o_cert_title { text-transform: uppercase; letter-spacing: 0.5px; font-size: 13px; font-weight: 600; color: #714B67; margin: 16px 0 4px; }
                        .o_cert_period { font-size: 10px; color: #6c757d; }
                        .o_cert_intro { text-align: justify; margin: 14px 0; }
                        .o_cert_partner { width: 100%; margin-bottom: 14px; }
                        .o_cert_partner td { border: 0 !important; padding: 3px 6px; vertical-align: top; }
                        .o_cert_partner .o_lbl { width: 28%; color: #6c757d; font-size: 10px; text-transform: uppercase; letter-spacing: 0.3px; }
                        .o_cert_partner .o_val { font-weight: 500; }
                        .o_cert_table { width: 100%; border-collapse: collapse; margin: 10px 0 14px; font-size: 10px; }
                        .o_cert_table thead th {
                            background: #f8f9fa;
                            border-bottom: 2px solid #714B67;
                            padding: 8px 10px;
                            font-weight: 600;
                            font-size: 10px;
                            text-transform: uppercase;
                            letter-spacing: 0.3px;
                            color: #495057;
                        }
                        .o_cert_table tbody td { border-bottom: 1px solid #dee2e6; padding: 7px 10px; }
                        .o_cert_table tfoot td { border-top: 2px solid #714B67; background: #f8f9fa; font-weight: 600; padding: 8px 10px; }
                        .tr { text-align: right; }
                        .tc { text-align: center; }
                        .o_cert_signature { margin-top: 36px; }
                        .o_cert_signature_line { border-top: 1px solid #495057; width: 260px; margin-top: 44px; padding-top: 6px; }
                        .o_cert_legal { margin-top: 18px; padding-top: 10px; border-top: 1px solid #dee2e6; font-size: 9px; color: #6c757d; }
                        .o_cert_footer { font-size: 8px; color: #adb5bd; border-top: 1px solid #dee2e6; padding: 5px 18mm; }
                        .o_cert_footer table { width: 100%; }
                        .o_cert_footer td { border: 0 !important; padding: 0; }
                    </style>
                </head>
                <!-- v14 wkhtmltopdf detects elements with class="header" / class="footer" and
                     renders them on every page. Custom classes like .o_cert_header are ignored
                     for the per-page repeat behavior, so we add the canonical classes alongside. -->
                <div class="header o_cert_header">
                        <table style="width:100%;">
                            <tr>
                                <td style="border:0; vertical-align:top;">
                                    <h1 class="o_cert_company"><t t-esc="cert.get('company_name', '')"/></h1>
                                    <p class="o_cert_subtitle">NIT <t t-esc="cert.get('company_vat', '')"/></p>
                                </td>
                                <td style="border:0; text-align:right; vertical-align:top; font-size:9px; color:#6c757d;">
                                    <t t-if="cert.get('consecutive')">
                                        <span class="badge" style="background:#714B67;color:#fff;padding:4px 8px;border-radius:4px;">
                                            No. <t t-esc="cert.get('consecutive', '')"/>
                                        </span><br/>
                                    </t>
                                    <span>Expedición: <t t-esc="cert.get('expedition_date', '')"/></span>
                                </td>
                            </tr>
                        </table>
                </div>

                <div class="page">

                    <div style="text-align:center;">
                        <div class="o_cert_title">Certificado de <t t-esc="cert.get('certificate_title', '')"/></div>
                        <div class="o_cert_period">Año gravable <t t-esc="cert.get('year', '')"/></div>
                    </div>

                    <p class="o_cert_intro">
                        Certificamos que <strong><t t-esc="cert.get('company_name', '')"/></strong>
                        efectuó <t t-esc="cert.get('certificate_title', '')"/>
                        durante el periodo comprendido entre
                        <strong><t t-esc="cert.get('date_from', '')"/></strong> y
                        <strong><t t-esc="cert.get('date_to', '')"/></strong> a:
                    </p>

                    <table class="o_cert_partner">
                        <tr>
                            <td class="o_lbl">Nombre / Razón social</td>
                            <td class="o_val"><t t-esc="cert.get('partner_name', '')"/></td>
                        </tr>
                        <tr t-if="cert.get('partner_commercial_name') and cert.get('partner_commercial_name') != cert.get('partner_name')">
                            <td class="o_lbl">Nombre comercial</td>
                            <td class="o_val"><t t-esc="cert.get('partner_commercial_name', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">Identificación</td>
                            <td class="o_val"><t t-esc="cert.get('partner_vat', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">Dirección</td>
                            <td class="o_val"><t t-esc="cert.get('partner_street', '')"/></td>
                        </tr>
                        <tr t-if="cert.get('partner_phone')">
                            <td class="o_lbl">Teléfono</td>
                            <td class="o_val"><t t-esc="cert.get('partner_phone', '')"/></td>
                        </tr>
                        <tr t-if="cert.get('partner_city')">
                            <td class="o_lbl">Ciudad</td>
                            <td class="o_val"><t t-esc="cert.get('partner_city', '')"/></td>
                        </tr>
                    </table>

                    <p style="margin-bottom:6px; color:#495057;">Detalle de la retención practicada por los siguientes conceptos:</p>

                    <table class="o_cert_table">
                        <thead>
                            <tr>
                                <th style="width:50%; text-align:left;">Concepto</th>
                                <th class="tr" style="width:20%;">Base retención</th>
                                <th class="tc" style="width:10%;" t-if="cert.get('certificate_type') == 'ica'">%</th>
                                <th class="tr" style="width:20%;">Total retenido</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cert.get('lines', [])" t-as="line">
                                <tr>
                                    <td>
                                        <t t-esc="line.get('account_name', '')"/>
                                        <span t-if="line.get('city_name')" style="color:#6c757d;"> — <t t-esc="line.get('city_name', '')"/></span>
                                    </td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(line.get('base_amount', 0))"/></td>
                                    <td class="tc" t-if="cert.get('certificate_type') == 'ica'">
                                        <t t-if="line.get('base_amount', 0) != 0">
                                            <t t-esc="'{:.2f}'.format(abs(line.get('retained_amount', 0) / line.get('base_amount', 1)) * 100)"/>
                                        </t>
                                    </td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(line.get('retained_amount', 0))"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td class="tr">$<t t-esc="'{:,.0f}'.format(cert.get('total_base', 0))"/></td>
                                <td t-if="cert.get('certificate_type') == 'ica'"/>
                                <td class="tr">$<t t-esc="'{:,.0f}'.format(cert.get('total_retained', 0))"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <p style="margin-top:14px;">
                        <span style="color:#6c757d; font-size:10px; text-transform:uppercase; letter-spacing:0.3px;">Domicilio del retenedor</span><br/>
                        <strong><t t-esc="cert.get('company_street', '')"/></strong>
                    </p>

                    <div class="o_cert_signature">
                        <t t-if="cert.get('signer_signature')">
                            <img t-att-src="'data:image/png;base64,' + cert.get('signer_signature', '')"
                                 style="max-height:60px; margin-bottom:-8px;" alt="Firma"/>
                        </t>
                        <div class="o_cert_signature_line">
                            <t t-if="cert.get('signer_name')">
                                <strong><t t-esc="cert.get('signer_name', '')"/></strong><br/>
                            </t>
                            <t t-if="cert.get('signer_position')">
                                <span style="color:#6c757d;"><t t-esc="cert.get('signer_position', '')"/></span><br/>
                            </t>
                            <t t-esc="cert.get('company_name', '')"/>
                        </div>
                    </div>

                    <div class="o_cert_legal">
                        <p style="margin:0; text-align:justify;">
                            Este documento no requiere para su validez firma autógrafa de acuerdo
                            con el artículo 10 del Decreto 836 de 1991, recopilado en el artículo
                            1.6.1.12.12 del DUR 1625 de octubre de 2016, que regula el contenido
                            del certificado de retenciones a título de renta.
                        </p>
                        <t t-if="cert.get('article')">
                            <p style="margin:6px 0 0;"><t t-esc="cert.get('article', '')"/></p>
                        </t>
                    </div>

                </div>

                <div class="footer o_cert_footer">
                    <table>
                        <tr>
                            <td style="text-align:left;">
                                Generado: <t t-esc="cert.get('generation_date', '')"/>
                                <t t-if="cert.get('notification_date')"> · Notificado: <t t-esc="cert.get('notification_date', '')"/></t>
                            </td>
                            <td style="text-align:center;">Elaboró: <t t-esc="cert.get('user_name', '')"/></td>
                            <td style="text-align:right;">
                                <t t-if="cert.get('consecutive')">No. <t t-esc="cert.get('consecutive', '')"/> · </t>
                                Pág <span class="page"/>/<span class="topage"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div style="page-break-after: always;"/>
        </template>

        <template id="cert_retention_modern">
            <t t-call="web.basic_layout">
                <head>
                    <style>
                        @page { size: letter; margin: 14mm 14mm 18mm 14mm; }
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
                            font-size: 10px;
                            color: #212529;
                            line-height: 1.5;
                        }
                        .o_hero {
                            background: #714B67;
                            color: #fff;
                            padding: 18px 22px;
                            border-radius: 8px;
                            margin-bottom: 16px;
                        }
                        .o_hero h1 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: 0.2px; }
                        .o_hero p { margin: 3px 0 0; font-size: 10px; opacity: 0.85; }
                        .o_hero .o_meta { text-align: right; font-size: 9px; opacity: 0.95; }
                        .o_hero .o_meta .o_badge {
                            display: inline-block;
                            background: rgba(255,255,255,0.18);
                            padding: 3px 10px;
                            border-radius: 20px;
                            font-weight: 500;
                            letter-spacing: 0.3px;
                        }
                        .o_section_title {
                            font-size: 10px;
                            font-weight: 600;
                            color: #714B67;
                            text-transform: uppercase;
                            letter-spacing: 0.6px;
                            margin: 16px 0 6px;
                            padding-bottom: 4px;
                            border-bottom: 1px solid #dee2e6;
                        }
                        .o_section_title .o_step {
                            display: inline-block;
                            background: #714B67;
                            color: #fff;
                            width: 18px; height: 18px;
                            border-radius: 50%;
                            text-align: center;
                            line-height: 18px;
                            font-size: 9px;
                            font-weight: 600;
                            margin-right: 6px;
                        }
                        .o_info { width: 100%; }
                        .o_info td { border: 0 !important; padding: 3px 8px 3px 0; vertical-align: top; }
                        .o_info .o_lbl { color: #6c757d; font-size: 9px; text-transform: uppercase; letter-spacing: 0.3px; width: 25%; }
                        .o_info .o_val { font-weight: 500; color: #212529; }
                        .o_table { width: 100%; border-collapse: collapse; margin: 8px 0; font-size: 10px; }
                        .o_table thead th {
                            background: #f1eef2;
                            color: #714B67;
                            padding: 8px 10px;
                            font-weight: 600;
                            font-size: 9px;
                            text-transform: uppercase;
                            letter-spacing: 0.4px;
                            border-bottom: 2px solid #714B67;
                        }
                        .o_table tbody td { padding: 7px 10px; border-bottom: 1px solid #e9ecef; }
                        .o_table tbody tr:last-child td { border-bottom: 0; }
                        .o_table tfoot td {
                            background: #f8f9fa;
                            border-top: 2px solid #714B67;
                            font-weight: 600;
                            padding: 8px 10px;
                        }
                        .tr { text-align: right; }
                        .tc { text-align: center; }
                        .o_title_band {
                            text-align: center;
                            margin: 14px 0;
                        }
                        .o_title_band .o_title {
                            font-size: 14px;
                            font-weight: 600;
                            color: #212529;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }
                        .o_title_band .o_year {
                            font-size: 10px;
                            color: #6c757d;
                            margin-top: 2px;
                        }
                        .o_signature {
                            margin-top: 28px;
                            padding-top: 14px;
                            border-top: 1px solid #dee2e6;
                        }
                        .o_signature .o_name { font-weight: 600; }
                        .o_legal {
                            font-size: 8px;
                            color: #6c757d;
                            margin-top: 16px;
                            padding: 10px 12px;
                            background: #f8f9fa;
                            border-left: 3px solid #714B67;
                            border-radius: 4px;
                        }
                        .o_footer {
                            font-size: 7px;
                            color: #adb5bd;
                            padding: 5px 14mm;
                            border-top: 1px solid #dee2e6;
                        }
                        .o_footer table { width: 100%; }
                        .o_footer td { border: 0 !important; padding: 0; }
                    </style>
                </head>

                <div class="header o_hero">
                        <table style="width:100%;">
                            <tr>
                                <td style="border:0; width:65%; vertical-align:top;">
                                    <h1><t t-esc="cert.get('company_name', '')"/></h1>
                                    <p>NIT <t t-esc="cert.get('company_vat', '')"/></p>
                                </td>
                                <td style="border:0; vertical-align:top;" class="o_meta">
                                    <t t-if="cert.get('consecutive')">
                                        <span class="o_badge">No. <t t-esc="cert.get('consecutive', '')"/></span><br/>
                                    </t>
                                    <span style="display:inline-block; margin-top:4px;">Expedición <t t-esc="cert.get('expedition_date', '')"/></span>
                                </td>
                            </tr>
                        </table>
                </div>

                <div class="page">

                    <div class="o_title_band">
                        <div class="o_title"><t t-esc="cert.get('certificate_title', '')"/></div>
                        <div class="o_year">Año gravable <t t-esc="cert.get('year', '')"/></div>
                    </div>

                    <div class="o_section_title"><span class="o_step">1</span>Datos del tercero retenido</div>
                    <table class="o_info">
                        <tr>
                            <td class="o_lbl">Razón social</td>
                            <td class="o_val"><t t-esc="cert.get('partner_name', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">NIT / C.C.</td>
                            <td class="o_val"><t t-esc="cert.get('partner_vat', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">Dirección</td>
                            <td class="o_val"><t t-esc="cert.get('partner_street', '')"/></td>
                        </tr>
                        <tr t-if="cert.get('partner_city')">
                            <td class="o_lbl">Ciudad</td>
                            <td class="o_val"><t t-esc="cert.get('partner_city', '')"/></td>
                        </tr>
                        <tr t-if="cert.get('partner_phone')">
                            <td class="o_lbl">Teléfono</td>
                            <td class="o_val"><t t-esc="cert.get('partner_phone', '')"/></td>
                        </tr>
                    </table>

                    <div class="o_section_title"><span class="o_step">2</span>Datos del agente retenedor</div>
                    <table class="o_info">
                        <tr>
                            <td class="o_lbl">Razón social</td>
                            <td class="o_val"><t t-esc="cert.get('company_name', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">NIT</td>
                            <td class="o_val"><t t-esc="cert.get('company_vat', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">Dirección</td>
                            <td class="o_val"><t t-esc="cert.get('company_street', '')"/></td>
                        </tr>
                        <tr>
                            <td class="o_lbl">Ciudad</td>
                            <td class="o_val"><t t-esc="cert.get('company_city', '')"/></td>
                        </tr>
                    </table>

                    <div class="o_section_title"><span class="o_step">3</span>Retención practicada</div>
                    <p style="margin:0 0 6px; font-size:9px; color:#6c757d;">
                        Período: <t t-esc="cert.get('date_from', '')"/> — <t t-esc="cert.get('date_to', '')"/>
                        <t t-if="cert.get('period_label')"> · <t t-esc="cert.get('period_label', '')"/></t>
                    </p>
                    <table class="o_table">
                        <thead>
                            <tr>
                                <th style="width:50%; text-align:left;">Concepto</th>
                                <th class="tr" style="width:20%;">Base gravable</th>
                                <th class="tc" style="width:10%;" t-if="cert.get('certificate_type') == 'ica'">%</th>
                                <th class="tr" style="width:20%;">Valor retenido</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="cert.get('lines', [])" t-as="line">
                                <tr>
                                    <td>
                                        <t t-esc="line.get('account_name', '')"/>
                                        <span t-if="line.get('city_name')" style="color:#adb5bd;"> (<t t-esc="line.get('city_name', '')"/>)</span>
                                    </td>
                                    <td class="tr">$<t t-esc="'{:,.0f}'.format(line.get('base_amount', 0))"/></td>
                                    <td class="tc" t-if="cert.get('certificate_type') == 'ica'">
                                        <t t-if="line.get('base_amount', 0) != 0">
                                            <t t-esc="'{:.2f}'.format(abs(line.get('retained_amount', 0) / line.get('base_amount', 1)) * 100)"/>
                                        </t>
                                    </td>
                                    <td class="tr">$<t t-esc="'{:,.0f}'.format(line.get('retained_amount', 0))"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>TOTAL</td>
                                <td class="tr">$<t t-esc="'{:,.0f}'.format(cert.get('total_base', 0))"/></td>
                                <td t-if="cert.get('certificate_type') == 'ica'"/>
                                <td class="tr">$<t t-esc="'{:,.0f}'.format(cert.get('total_retained', 0))"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="o_signature">
                        <p style="font-size:9px; color:#6c757d; margin:0 0 4px;">Fecha de expedición: <t t-esc="cert.get('expedition_date', '')"/></p>
                        <t t-if="cert.get('signer_signature')">
                            <img t-att-src="'data:image/png;base64,' + cert.get('signer_signature', '')"
                                 style="max-height:50px;" alt="Firma"/>
                            <br/>
                        </t>
                        <t t-if="cert.get('signer_name')">
                            <span class="o_name"><t t-esc="cert.get('signer_name', '')"/></span><br/>
                        </t>
                        <t t-if="cert.get('signer_position')">
                            <span style="color:#6c757d;"><t t-esc="cert.get('signer_position', '')"/></span><br/>
                        </t>
                        <t t-esc="cert.get('company_name', '')"/>
                    </div>

                    <div class="o_legal">
                        <p style="margin:0; text-align:justify;">
                            Este documento no requiere para su validez firma autógrafa de acuerdo
                            con el artículo 10 del Decreto 836 de 1991, recopilado en el artículo
                            1.6.1.12.12 del DUR 1625 de octubre de 2016.
                        </p>
                        <t t-if="cert.get('article')">
                            <p style="margin:4px 0 0;"><t t-esc="cert.get('article', '')"/></p>
                        </t>
                    </div>

                </div>

                <div class="footer o_footer">
                    <table>
                        <tr>
                            <td style="text-align:left;">
                                Generado: <t t-esc="cert.get('generation_date', '')"/>
                                <t t-if="cert.get('notification_date')"> · Notificado: <t t-esc="cert.get('notification_date', '')"/></t>
                            </td>
                            <td style="text-align:center;">Elaboró: <t t-esc="cert.get('user_name', '')"/></td>
                            <td style="text-align:right;">
                                <t t-if="cert.get('consecutive')">No. <t t-esc="cert.get('consecutive', '')"/> · </t>
                                Pág <span class="page"/>/<span class="topage"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
            <div style="page-break-after: always;"/>
        </template>

        <record id="action_report_certificate_retention" model="ir.actions.report">
            <field name="name">Certificado de Retención</field>
            <field name="model">l10n_co.exogenous_certificate_history</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_co_exogenous_information_reporting.cert_retention</field>
            <field name="report_file">l10n_co_exogenous_information_reporting.cert_retention</field>
            <field name="print_report_name">'Certificado_Retencion_%s_%s' % (object.partner_id.vat or '', object.year)</field>
            <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

    </data>
</odoo>
