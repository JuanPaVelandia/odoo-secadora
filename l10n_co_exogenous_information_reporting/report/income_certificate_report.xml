<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paperformat Letter con márgenes apretados para que el certificado
             quepa en una sola hoja. Se asigna al ir.actions.report y se reusa
             desde _generate_pdf cuando se imprime con la plantilla HTML
             personalizada (DEFAULT_HTML_TEMPLATE). -->
        <record id="paperformat_income_certificate" model="report.paperformat">
            <field name="name">Certificado Ingresos (Legal compacto)</field>
            <field name="format">Legal</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">0</field>
            <field name="header_line" eval="False"/>
            <field name="dpi">90</field>
        </record>

        <!-- ir.actions.report — Certificado de Ingresos y Retenciones (individual) -->
        <record id="action_report_income_certificate_individual" model="ir.actions.report">
            <field name="name">Certificado de Ingresos y Retenciones</field>
            <field name="model">l10n_co.exogenous_income_cert_request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_co_exogenous_information_reporting.report_income_certificate_individual</field>
            <field name="report_file">l10n_co_exogenous_information_reporting.report_income_certificate_individual</field>
            <field name="paperformat_id" ref="paperformat_income_certificate"/>
            <field name="binding_model_id" ref="model_l10n_co_exogenous_income_cert_request"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Certificado_Ingresos_%s_%s' % (object.employee_id.name or '', object.year)</field>
        </record>

        <!-- Template QWeb (server-side, v14) -->
        <template id="report_income_certificate_individual">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.basic_layout">
                        <head>
                            <style>
                                @page { size: legal; margin: 5mm; }
                                html, body { margin: 0; padding: 0; }
                                body { font-family: Arial, sans-serif; font-size: 8px; color: #212529; }
                                table { page-break-inside: avoid; }
                                h2 { font-size: 11px; margin: 0 0 4px; text-align: center; }
                                h4 { font-size: 8.5px; margin: 6px 0 2px; }
                                .o_inc_meta { width: 100%; margin: 4px 0 6px; font-size: 8px; }
                                .o_inc_meta td { padding: 1px 4px; }
                                .o_inc_meta .o_lbl { color: #6c757d; text-transform: uppercase; letter-spacing: 0.2px; width: 22%; }
                                .o_inc_table { width: 100%; border-collapse: collapse; margin: 4px 0; }
                                .o_inc_table th, .o_inc_table td {
                                    border: 1px solid #ced4da; padding: 1px 3px; font-size: 7.5px;
                                    line-height: 1.1;
                                }
                                .o_inc_table thead th { background: #f1f3f5; text-transform: uppercase; letter-spacing: 0.2px; }
                                .o_inc_amount { text-align: right; font-variant-numeric: tabular-nums; }
                                .o_inc_seq { text-align: center; width: 45px; }
                                .o_inc_footer { margin-top: 8px; font-size: 6.5px; color: #6c757d; }
                            </style>
                        </head>
                        <t t-set="company" t-value="doc.company_id"/>
                        <t t-set="employee" t-value="doc.employee_id"/>
                        <t t-set="header" t-value="doc.header_id"/>
                        <t t-set="cert_data" t-value="doc.get_certificate_data()"/>

                        <h2>Certificado de Ingresos y Retenciones</h2>
                        <div class="text-center" style="font-size: 10px; color: #6c757d;">
                            Año gravable <t t-esc="doc.year"/>
                            <t t-if="header and header.form_number"> · Formulario <t t-esc="header.form_number"/></t>
                        </div>

                        <table class="o_inc_meta">
                            <tr>
                                <td class="o_lbl">Empresa</td>
                                <td><t t-esc="company.name or ''"/></td>
                                <td class="o_lbl">NIT</td>
                                <td><t t-esc="company.partner_id.vat or ''"/></td>
                            </tr>
                            <tr>
                                <td class="o_lbl">Empleado</td>
                                <td><t t-esc="employee.name or ''"/></td>
                                <td class="o_lbl">Documento</td>
                                <td><t t-esc="employee.address_home_id.vat or '' if employee.address_home_id else ''"/></td>
                            </tr>
                            <tr>
                                <td class="o_lbl">Período</td>
                                <td>
                                    <t t-esc="doc.date_from.strftime('%d/%m/%Y') if doc.date_from else ''"/>
                                    -
                                    <t t-esc="doc.date_to.strftime('%d/%m/%Y') if doc.date_to else ''"/>
                                </td>
                                <td class="o_lbl">Fecha de expedición</td>
                                <td>
                                    <t t-if="header and header.issue_date" t-esc="header.issue_date.strftime('%d/%m/%Y')"/>
                                    <t t-if="not header or not header.issue_date">-</t>
                                </td>
                            </tr>
                        </table>

                        <h4 style="font-size: 8.5px; margin: 6px 0 2px; text-transform: uppercase; letter-spacing: 0.3px; color: #495057;">
                            Ingresos
                        </h4>
                        <table class="o_inc_table">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th class="o_inc_seq">Renglón</th>
                                    <th class="o_inc_amount">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cert_data.get('income_lines', [])" t-as="ln">
                                    <tr t-att-style="'font-weight:600;background:#f1f3f5;' if ln.get('is_total') else ''">
                                        <td><t t-esc="ln.get('concept', '')"/></td>
                                        <td class="o_inc_seq"><t t-esc="ln.get('renglon', '')"/></td>
                                        <td class="o_inc_amount"><t t-esc="ln.get('value', '')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 style="font-size: 8.5px; margin: 6px 0 2px; text-transform: uppercase; letter-spacing: 0.3px; color: #495057;">
                            Aportes obligatorios y retención
                        </h4>
                        <table class="o_inc_table">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th class="o_inc_seq">Renglón</th>
                                    <th class="o_inc_amount">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cert_data.get('contribution_lines', [])" t-as="ln">
                                    <tr t-att-style="'font-weight:600;background:#fff3cd;' if ln.get('is_retention') else ''">
                                        <td><t t-esc="ln.get('concept', '')"/></td>
                                        <td class="o_inc_seq"><t t-esc="ln.get('renglon', '')"/></td>
                                        <td class="o_inc_amount"><t t-esc="ln.get('value', '')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4 style="font-size: 8.5px; margin: 6px 0 2px; text-transform: uppercase; letter-spacing: 0.3px; color: #495057;">
                            Conceptos a cargo del trabajador
                        </h4>
                        <table class="o_inc_table">
                            <thead>
                                <tr>
                                    <th rowspan="2">Concepto</th>
                                    <th colspan="2" class="text-center">Recibido</th>
                                    <th colspan="2" class="text-center">Retenido</th>
                                </tr>
                                <tr>
                                    <th class="o_inc_seq">Renglón</th>
                                    <th class="o_inc_amount">Valor</th>
                                    <th class="o_inc_seq">Renglón</th>
                                    <th class="o_inc_amount">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cert_data.get('worker_lines', [])" t-as="ln">
                                    <tr t-att-style="'font-weight:700;background:#cfe2ff;' if ln.get('is_grand_total') else ('font-weight:600;background:#f1f3f5;' if ln.get('is_total') else '')">
                                        <td><t t-esc="ln.get('concept', '')"/></td>
                                        <td class="o_inc_seq"><t t-esc="ln.get('renglon_received', '')"/></td>
                                        <td class="o_inc_amount"><t t-esc="ln.get('value_received', '')"/></td>
                                        <td class="o_inc_seq"><t t-esc="ln.get('renglon_retained', '')"/></td>
                                        <td class="o_inc_amount"><t t-esc="ln.get('value_retained', '')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="o_inc_footer">
                            Generado el
                            <t t-esc="doc.generation_date.strftime('%Y-%m-%d %H:%M') if doc.generation_date else ''"/>
                            por <t t-esc="doc.create_uid.name or ''"/>.
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
