<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_finca_contrato_form" model="ir.ui.view">
            <field name="name">finca.contrato.form</field>
            <field name="model">finca.contrato</field>
            <field name="arch" type="xml">
                <form string="Labor por contrato">
                    <header>
                        <button name="action_confirmar" string="Confirmar" type="object"
                                class="oe_highlight" invisible="state != 'borrador'"/>
                        <button name="action_borrador" string="Volver a borrador" type="object"
                                invisible="state == 'borrador'"
                                groups="finca_labores.group_finca_admin"/>
                        <button name="action_cancelar" string="Cancelar" type="object"
                                invisible="state != 'borrador'"/>
                        <field name="state" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="campana_id" readonly="state != 'borrador'"/>
                                <field name="fecha" readonly="state != 'borrador'"/>
                                <field name="finca_id" readonly="state != 'borrador'"/>
                                <field name="lote_id" readonly="state != 'borrador'"
                                       context="{'default_finca_id': finca_id}"/>
                                <field name="dueno_id" readonly="state != 'borrador'"/>
                            </group>
                            <group>
                                <field name="labor_id" readonly="state != 'borrador'"/>
                                <label for="cantidad"/>
                                <div class="o_row">
                                    <field name="cantidad" readonly="state != 'borrador'"/>
                                    <field name="unidad" readonly="1" nolabel="1"/>
                                </div>
                                <field name="tarifa" readonly="state != 'borrador'"/>
                                <field name="total"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Operadores" name="operadores">
                                <field name="linea_ids" readonly="state != 'borrador'">
                                    <list editable="bottom">
                                        <field name="operador_id"/>
                                        <field name="participacion"/>
                                        <field name="valor" sum="Total"/>
                                    </list>
                                </field>
                                <p class="text-muted">
                                    El total se reparte según la participación. Con 1 para
                                    todos queda en partes iguales, como el "Entre cuántos" de la hoja.
                                </p>
                            </page>
                            <page string="Observaciones" name="observaciones">
                                <field name="observaciones" placeholder="Observaciones..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_finca_contrato_list" model="ir.ui.view">
            <field name="name">finca.contrato.list</field>
            <field name="model">finca.contrato</field>
            <field name="arch" type="xml">
                <list string="Labores por contrato"
                      decoration-info="state == 'borrador'"
                      decoration-muted="state == 'cancelado'">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="campana_id" optional="hide"/>
                    <field name="finca_id"/>
                    <field name="lote_id"/>
                    <field name="labor_id"/>
                    <field name="cantidad"/>
                    <field name="unidad" optional="show"/>
                    <field name="tarifa" optional="show"/>
                    <field name="cantidad_operadores" optional="show"/>
                    <field name="total" sum="Total"/>
                    <field name="dueno_id" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'borrador'"
                           decoration-success="state == 'confirmado'"
                           decoration-muted="state == 'cancelado'"/>
                </list>
            </field>
        </record>

        <record id="view_finca_contrato_search" model="ir.ui.view">
            <field name="name">finca.contrato.search</field>
            <field name="model">finca.contrato</field>
            <field name="arch" type="xml">
                <search string="Buscar labores">
                    <field name="name"/>
                    <field name="finca_id"/>
                    <field name="lote_id"/>
                    <field name="labor_id"/>
                    <field name="linea_ids" string="Operador" filter_domain="[('linea_ids.operador_id', 'ilike', self)]"/>
                    <field name="dueno_id"/>
                    <separator/>
                    <filter name="filter_borrador" string="Borrador" domain="[('state', '=', 'borrador')]"/>
                    <filter name="filter_confirmado" string="Confirmado" domain="[('state', '=', 'confirmado')]"/>
                    <separator/>
                    <filter name="filter_campana_abierta" string="Campaña abierta"
                            domain="[('campana_id.state', '=', 'abierta')]"/>
                    <group>
                        <filter name="group_finca" string="Finca" context="{'group_by': 'finca_id'}"/>
                        <filter name="group_labor" string="Labor" context="{'group_by': 'labor_id'}"/>
                        <filter name="group_dueno" string="Dueño" context="{'group_by': 'dueno_id'}"/>
                        <filter name="group_campana" string="Campaña" context="{'group_by': 'campana_id'}"/>
                        <filter name="group_mes" string="Mes" context="{'group_by': 'fecha:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_finca_contrato" model="ir.actions.act_window">
            <field name="name">Labores por contrato</field>
            <field name="res_model">finca.contrato</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_finca_contrato_search"/>
            <field name="context">{'search_default_filter_campana_abierta': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Registrar una labor por contrato</p>
                <p>Finca, lote y labor; la cantidad y la tarifa se proponen solas.
                   Agregue los operadores que la hicieron y confirme.</p>
            </field>
        </record>

    </data>
</odoo>
