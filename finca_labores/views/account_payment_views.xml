<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Al final de la hoja: el formulario de pago tiene dos campos
             partner_id (cliente/proveedor) y no conviene anclarse a ninguno. -->
        <record id="view_account_payment_form_finca" model="ir.ui.view">
            <field name="name">account.payment.form.finca.labores</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Labores de finca" name="finca_labores"
                           invisible="not finca_campana_id and not partner_id">
                        <group>
                            <field name="finca_campana_id"/>
                            <field name="finca_pagador_id" invisible="not finca_campana_id"/>
                            <field name="finca_dueno_id" invisible="not finca_campana_id"
                                   required="finca_campana_id"/>
                        </group>
                        <group invisible="not finca_campana_id">
                            <field name="finca_liquidacion_ids" widget="many2many_tags"
                                   invisible="not finca_liquidacion_ids"/>
                            <field name="finca_reparto_total" invisible="not finca_reparto_ids"/>
                            <field name="finca_reparto_diferencia" invisible="not finca_reparto_ids"
                                   decoration-danger="finca_reparto_diferencia"/>
                        </group>
                        <!-- Un giro para varios: a quién le corresponde cada peso.
                             Sin líneas, el pago es todo de su contacto. -->
                        <div colspan="2" invisible="not finca_campana_id" class="mt-2">
                            <button name="action_finca_proponer_reparto" type="object"
                                    string="Proponer reparto por saldos" class="btn btn-link px-0"
                                    icon="fa-magic" invisible="not finca_dueno_id"
                                    help="Reparte el pago entre los operadores con saldo pendiente del dueño en la campaña, de mayor a menor."/>
                        </div>
                        <field name="finca_reparto_ids" colspan="2" nolabel="1"
                               invisible="not finca_campana_id">
                            <list editable="bottom">
                                <field name="operador_id"/>
                                <field name="dueno_id" optional="hide"/>
                                <field name="monto" sum="Total"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_account_payment_search_finca" model="ir.ui.view">
            <field name="name">account.payment.search.finca.labores</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <separator/>
                    <filter name="filter_finca_labores" string="Pagos de labores"
                            domain="[('finca_campana_id', '!=', False)]"/>
                    <filter name="filter_finca_sin_dueno" string="Labores sin dueño"
                            domain="[('finca_campana_id', '!=', False), ('finca_dueno_id', '=', False)]"/>
                </xpath>
            </field>
        </record>

        <!-- Desde el menú de labores: pagos a operadores, para revisar que
             cada uno tenga campaña y dueño. -->
        <record id="action_finca_pagos" model="ir.actions.act_window">
            <field name="name">Pagos a operadores</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">['|', ('partner_id.es_operador_finca', '=', True), ('finca_reparto_ids', '!=', False)]</field>
            <field name="context">{'create': False}</field>
        </record>

    </data>
</odoo>
