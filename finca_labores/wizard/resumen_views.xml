<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Filtros arriba en dos columnas (campaña y dueño / operador) y el
             tablero debajo; el detalle se abre con los botones del encabezado. -->
        <record id="view_finca_resumen_form" model="ir.ui.view">
            <field name="name">finca.resumen.form</field>
            <field name="model">finca.resumen</field>
            <field name="arch" type="xml">
                <form string="Resumen de saldos" create="false" delete="false" duplicate="false">
                    <header>
                        <button name="action_ver_movimientos" type="object" string="Ver movimientos"
                                icon="fa-list"/>
                        <button name="action_ver_pivote" type="object" string="Ver pivote"
                                icon="fa-table"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="campana_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="solo_pendientes" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="dueno_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="operador_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <field name="resumen_html" nolabel="1" readonly="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_finca_resumen" model="ir.actions.act_window">
            <field name="name">Resumen de saldos</field>
            <field name="res_model">finca.resumen</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>
