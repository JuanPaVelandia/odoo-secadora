<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_finca_resumen_form" model="ir.ui.view">
            <field name="name">finca.resumen.form</field>
            <field name="model">finca.resumen</field>
            <field name="arch" type="xml">
                <form string="Resumen de saldos">
                    <sheet>
                        <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                            <div>
                                <label for="campana_id" class="small text-muted d-block"/>
                                <field name="campana_id" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div>
                                <label for="dueno_id" class="small text-muted d-block"/>
                                <field name="dueno_id" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div>
                                <label for="operador_id" class="small text-muted d-block"/>
                                <field name="operador_id" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div>
                                <field name="solo_pendientes"/>
                                <label for="solo_pendientes"/>
                            </div>
                            <div class="ms-auto">
                                <button name="action_ver_pivote" type="object" string="Pivote"
                                        class="btn-secondary" icon="fa-table"/>
                                <button name="action_ver_movimientos" type="object" string="Movimientos"
                                        class="btn-secondary ms-1" icon="fa-list"/>
                            </div>
                        </div>
                        <field name="resumen_html" nolabel="1" readonly="1"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_finca_resumen" model="ir.actions.act_window">
            <field name="name">Resumen de saldos</field>
            <field name="res_model">finca.resumen</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

    </data>
</odoo>
