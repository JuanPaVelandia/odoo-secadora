<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Objetivos de la fórmula de doble descuento para estimar peso seco -->
        <record id="param_humedad_objetivo" model="ir.config_parameter">
            <field name="key">secadora_embolsado.humedad_objetivo</field>
            <field name="value">13.0</field>
        </record>

        <!-- % de la impureza inicial que conserva el arroz seco (60 = se
             descuenta solo el 40% de la impureza medida) -->
        <record id="param_impureza_objetivo_pct" model="ir.config_parameter">
            <field name="key">secadora_embolsado.impureza_objetivo_pct_inicial</field>
            <field name="value">60.0</field>
        </record>

        <!-- Días de vigencia de una tara antes de alertar que está vieja -->
        <record id="param_tara_max_dias" model="ir.config_parameter">
            <field name="key">secadora_embolsado.tara_max_dias</field>
            <field name="value">7</field>
        </record>

        <!-- Certificado de inventarios: destinatarios del envío diario -->
        <record id="param_certificado_destinatarios" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_destinatarios</field>
            <field name="value">mydiaz@almaviva.com.co</field>
        </record>

        <!-- Datos que salen impresos en el certificado -->
        <record id="param_certificado_certificante_nombre" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_certificante_nombre</field>
            <field name="value">JOSE EDUARDO VELANDIA OTALORA</field>
        </record>

        <record id="param_certificado_certificante_cc" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_certificante_cc</field>
            <field name="value">74.750.290</field>
        </record>

        <record id="param_certificado_firmante_nombre" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_firmante_nombre</field>
            <field name="value">Juan Pablo Velandia Cala</field>
        </record>

        <record id="param_certificado_firmante_cc" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_firmante_cc</field>
            <field name="value">1.026.297.343</field>
        </record>

        <record id="param_certificado_firmante_cargo" model="ir.config_parameter">
            <field name="key">secadora_embolsado.certificado_firmante_cargo</field>
            <field name="value">Administrador</field>
        </record>

    </data>
</odoo>
