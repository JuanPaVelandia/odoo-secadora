<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Certificado diario de inventarios: se genera y se envía por correo.
             La hora se guarda en UTC: 9:00 pm de Colombia (UTC-5) = 02:00 UTC
             del día siguiente. -->
        <record id="cron_certificado_inventario_diario" model="ir.cron">
            <field name="name">Certificado de Inventarios Diario</field>
            <field name="model_id" ref="model_secadora_certificado_inventario"/>
            <field name="state">code</field>
            <field name="code">model._cron_certificado_diario()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
