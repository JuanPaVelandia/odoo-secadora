<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_certificado_inventario_list" model="ir.ui.view">
            <field name="name">secadora.certificado.inventario.list</field>
            <field name="model">secadora.certificado.inventario</field>
            <field name="arch" type="xml">
                <list string="Certificados de Inventarios">
                    <field name="name"/>
                    <field name="fecha"/>
                    <field name="cantidad_silobolsas"/>
                    <field name="total_embolsado_kg" sum="Total"/>
                    <field name="total_desembolsado_kg" sum="Total"/>
                    <field name="total_saldo_kg" sum="Total"/>
                    <field name="destinatarios" optional="show"/>
                    <field name="fecha_envio" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'enviado'"
                           decoration-info="state == 'emitido'"
                           decoration-muted="state == 'borrador'"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_certificado_inventario_form" model="ir.ui.view">
            <field name="name">secadora.certificado.inventario.form</field>
            <field name="model">secadora.certificado.inventario</field>
            <field name="arch" type="xml">
                <form string="Certificado de Inventarios">
                    <header>
                        <button name="action_calcular" string="Calcular"
                                type="object" class="btn-primary"
                                invisible="state == 'enviado'"/>
                        <button name="action_emitir" string="Emitir"
                                type="object" class="btn-primary"
                                invisible="state != 'borrador'"/>
                        <button name="action_enviar_correo" string="Enviar por Correo"
                                type="object" class="btn-primary"
                                invisible="state != 'emitido'"
                                confirm="¿Enviar el certificado por correo a los destinatarios?"/>
                        <button name="action_volver_borrador" string="Volver a Borrador"
                                type="object"
                                invisible="state != 'emitido'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="borrador,emitido,enviado"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="fecha" readonly="state == 'enviado'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="cantidad_silobolsas"/>
                            </group>
                            <group>
                                <field name="total_embolsado_kg"/>
                                <field name="total_desembolsado_kg"/>
                                <field name="total_saldo_kg"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Silobolsas" name="lineas">
                                <field name="linea_ids" readonly="1">
                                    <list string="Líneas" editable="bottom">
                                        <field name="silobolsa_id"/>
                                        <field name="ubicacion" optional="show"/>
                                        <field name="variedad_id" optional="show"/>
                                        <field name="embolsado_kg" sum="Total"/>
                                        <field name="desembolsado_kg" sum="Total"/>
                                        <field name="saldo_kg" sum="Total"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Envío" name="envio">
                                <group>
                                    <field name="destinatarios"
                                           placeholder="correo@dominio.com, otro@dominio.com"/>
                                    <field name="fecha_envio"/>
                                    <field name="mail_id"/>
                                </group>
                                <group string="Notas">
                                    <field name="notas" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_certificado_inventario_search" model="ir.ui.view">
            <field name="name">secadora.certificado.inventario.search</field>
            <field name="model">secadora.certificado.inventario</field>
            <field name="arch" type="xml">
                <search string="Buscar Certificados">
                    <field name="name"/>
                    <field name="fecha"/>
                    <filter name="filtro_borrador" string="Borrador" domain="[('state', '=', 'borrador')]"/>
                    <filter name="filtro_emitido" string="Emitidos" domain="[('state', '=', 'emitido')]"/>
                    <filter name="filtro_enviado" string="Enviados" domain="[('state', '=', 'enviado')]"/>
                    <separator/>
                    <filter name="filtro_mes" string="Este Mes"
                            domain="[('fecha', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <group>
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_fecha" string="Fecha" context="{'group_by': 'fecha'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_certificado_inventario" model="ir.actions.act_window">
            <field name="name">Certificados de Inventarios</field>
            <field name="res_model">secadora.certificado.inventario</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aún no hay certificados de inventarios
                </p>
                <p>
                    El certificado se genera y se envía automáticamente todos los días.
                    También puede crear uno manualmente para una fecha específica.
                </p>
            </field>
        </record>

    </data>
</odoo>
