<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_pesajes_google_sheets" model="ir.cron">
            <field name="name">Pesajes: publicar en Google Sheets</field>
            <field name="model_id" ref="model_secadora_google_sheets_sync"/>
            <field name="state">code</field>
            <field name="code">model._cron_publicar_pesajes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_horometros_google_sheets" model="ir.cron">
            <field name="name">Horómetros: publicar en Google Sheets</field>
            <field name="model_id" ref="model_secadora_google_sheets_sync"/>
            <field name="state">code</field>
            <field name="code">model._cron_publicar_horometros()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
