<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_movimiento_bultos_list" model="ir.ui.view">
            <field name="name">secadora.movimiento.bultos.list</field>
            <field name="model">secadora.movimiento.bultos</field>
            <field name="arch" type="xml">
                <!-- Solo lectura: el historial lo escribe el sistema, no se
                     corrige a mano. Para arreglar un saldo se registra un
                     movimiento de ajuste. -->
                <list string="Movimientos de bultos" create="0" edit="0" delete="0"
                      decoration-muted="tipo == 'traslado'"
                      decoration-danger="tipo == 'salida_flete'">
                    <field name="fecha"/>
                    <field name="tipo"/>
                    <field name="cliente_id" optional="show"/>
                    <field name="registro_bultos_id" optional="hide"/>
                    <field name="variedad_id" optional="show"/>
                    <field name="bodega_origen_id"/>
                    <field name="bodega_destino_id"/>
                    <field name="cantidad" sum="Bultos"/>
                    <field name="usuario_id" optional="hide"/>
                    <field name="notas" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_movimiento_bultos_search" model="ir.ui.view">
            <field name="name">secadora.movimiento.bultos.search</field>
            <field name="model">secadora.movimiento.bultos</field>
            <field name="arch" type="xml">
                <search>
                    <field name="cliente_id"/>
                    <field name="variedad_id"/>
                    <field name="bodega_origen_id"/>
                    <field name="bodega_destino_id"/>
                    <filter name="filter_ingreso" string="Ingresos"
                            domain="[('tipo', '=', 'ingreso')]"/>
                    <filter name="filter_salida" string="Salidas en flete"
                            domain="[('tipo', '=', 'salida_flete')]"/>
                    <filter name="filter_traslado" string="Traslados"
                            domain="[('tipo', '=', 'traslado')]"/>
                    <separator/>
                    <filter name="filter_fecha" string="Fecha" date="fecha"/>
                    <group>
                        <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                        <filter name="group_origen" string="Bodega de origen" context="{'group_by': 'bodega_origen_id'}"/>
                        <filter name="group_destino" string="Bodega de destino" context="{'group_by': 'bodega_destino_id'}"/>
                        <filter name="group_variedad" string="Variedad" context="{'group_by': 'variedad_id'}"/>
                        <filter name="group_cliente" string="Dueño" context="{'group_by': 'cliente_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_movimiento_bultos" model="ir.actions.act_window">
            <field name="name">Movimientos de bultos</field>
            <field name="res_model">secadora.movimiento.bultos</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_movimiento_bultos_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Todavía no hay movimientos
                </p>
                <p>
                    Aquí queda el rastro de los bultos: cuándo entraron a una
                    bodega, cuándo se trasladaron y cuándo salieron en un flete.
                </p>
            </field>
        </record>

    </data>
</odoo>
