# Copia este archivo a .env y rellena la contraseña.
# .env está ignorado por git: nunca subas credenciales.

# ---------------------------------------------------------------
# MODO POSTGRES (por defecto) — no consume licencia de Odoo.
# Requiere el túnel SSH abierto (ver README, paso 3).
# ---------------------------------------------------------------
MODO_CONEXION=postgres

PG_HOST=127.0.0.1
PG_PORT=15432
PG_DB=secadora_2
PG_USER=claude_lectura
PG_PASSWORD=la-contrasena-que-pusiste-en-el-sql

# ---------------------------------------------------------------
# MODO XMLRPC (alternativa) — respeta los permisos de Odoo, pero
# gasta un usuario interno de pago. Cambia MODO_CONEXION=xmlrpc.
# ---------------------------------------------------------------
# ODOO_URL=https://odoo19.srv1360477.hstgr.cloud
# ODOO_DB=secadora_2
# ODOO_USER=consultas.claude@paramoagro.com
# ODOO_PASSWORD=la-api-key
