<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- El inventario de empaques es de la secadora: lo ve quien la tenga
             entre sus compañías activas. -->
        <record id="empaque_movimiento_company_rule" model="ir.rule">
            <field name="name">Movimiento de empaques: Multi-Company</field>
            <field name="model_id" ref="model_secadora_empaque_movimiento"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
