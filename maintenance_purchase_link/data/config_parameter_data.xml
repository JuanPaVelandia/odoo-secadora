<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Fecha pivote de costos de mantenimiento.

             Los costos anteriores a esta fecha ya vienen del histórico
             importado de Fracttal, que se trajo desde el principio. Las
             facturas de contabilidad se migran desde enero, así que sin este
             corte el mismo gasto quedaría contado dos veces.

             noupdate="1": una vez fijada, actualizar el módulo no la pisa. -->
        <record id="param_fecha_pivote_costos" model="ir.config_parameter">
            <field name="key">maintenance_purchase_link.fecha_pivote_costos</field>
            <field name="value">2026-07-20</field>
        </record>

    </data>
</odoo>
