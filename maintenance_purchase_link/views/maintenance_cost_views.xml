<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Vistas de maintenance.equipment.cost.line (modelo intermedio) -->
    <!-- ============================================================ -->

    <!-- Vista lista -->
    <record id="view_equipment_cost_line_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.cost.line.list</field>
        <field name="model">maintenance.equipment.cost.line</field>
        <field name="arch" type="xml">
            <list string="Costos de mantenimiento">
                <field name="date"/>
                <field name="origin" optional="show"/>
                <field name="equipment_id"/>
                <field name="request_id"/>
                <field name="name" string="Recurso"/>
                <field name="quantity"/>
                <field name="uom_name" optional="hide"/>
                <field name="unit_cost" optional="hide"/>
                <field name="product_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="source_name" string="Fuente" optional="hide"/>
                <field name="external_ref" string="Ref. externa" optional="hide"/>
                <field name="move_id" optional="hide"/>
                <field name="percentage" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="x_webviewlink" widget="url" string="Enlace Drive" optional="hide"/>
                <field name="attachment_count" string="Adjuntos" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_equipment_cost_line_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.cost.line.form</field>
        <field name="model">maintenance.equipment.cost.line</field>
        <field name="arch" type="xml">
            <form string="Costo de mantenimiento">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip"
                                invisible="not move_id">
                            <field name="attachment_count" string="Adjuntos" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group string="Costo">
                            <field name="origin"/>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_name"/>
                            <field name="unit_cost"/>
                            <field name="amount" readonly="origin == 'invoice'"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Asignación">
                            <field name="equipment_id"/>
                            <field name="request_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Factura" invisible="origin != 'invoice'">
                        <field name="move_id" readonly="1"/>
                        <field name="move_line_id" readonly="1"/>
                        <field name="percentage"/>
                        <field name="x_webviewlink" widget="url"/>
                        <field name="x_whatsapp_comprobante_link" widget="url"/>
                        <field name="x_whatsapp_mensaje"/>
                    </group>
                    <group string="Origen externo" invisible="origin == 'invoice'">
                        <field name="source_name"/>
                        <field name="code"/>
                        <field name="resource_type"/>
                        <field name="external_ref"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista búsqueda -->
    <record id="view_equipment_cost_line_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.cost.line.search</field>
        <field name="model">maintenance.equipment.cost.line</field>
        <field name="arch" type="xml">
            <search string="Buscar costos de equipo">
                <field name="equipment_id"/>
                <field name="name" string="Recurso"/>
                <field name="product_id"/>
                <field name="request_id"/>
                <field name="partner_id"/>
                <field name="source_name" string="Fuente"/>
                <field name="external_ref"/>
                <field name="move_id"/>
                <filter name="filter_invoice" string="Con factura"
                        domain="[('origin', '=', 'invoice')]"/>
                <filter name="filter_historic" string="Histórico importado"
                        domain="[('origin', '=', 'historic')]"/>
                <filter name="filter_manual" string="Registro manual"
                        domain="[('origin', '=', 'manual')]"/>
                <separator/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <separator/>
                <group>
                    <filter name="group_equipment" string="Equipo"
                            context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_request" string="Orden de trabajo"
                            context="{'group_by': 'request_id'}"/>
                    <filter name="group_origin" string="Origen"
                            context="{'group_by': 'origin'}"/>
                    <filter name="group_product" string="Recurso"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Proveedor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_source" string="Fuente"
                            context="{'group_by': 'source_name'}"/>
                    <filter name="group_month" string="Mes"
                            context="{'group_by': 'date:month'}"/>
                    <filter name="group_company" string="Compañía"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista pivot -->
    <record id="view_equipment_cost_line_pivot" model="ir.ui.view">
        <field name="name">maintenance.equipment.cost.line.pivot</field>
        <field name="model">maintenance.equipment.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="Costos de Mantenimiento">
                <field name="equipment_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Acción principal de costos. El nombre coincide con el del menú: el
         breadcrumb debe decir lo mismo por donde se entró. -->
    <record id="action_equipment_cost_lines" model="ir.actions.act_window">
        <field name="name">Costos de mantenimiento</field>
        <field name="res_model">maintenance.equipment.cost.line</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_equipment_cost_line_search"/>
    </record>

    <!-- Vista pivot de la acción de costos, junto a ella: vivía en un archivo
         report/ que no contenía ningún reporte y se cargaba después del menú. -->
    <record id="action_equipment_cost_lines_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_equipment_cost_line_pivot"/>
        <field name="act_window_id" ref="action_equipment_cost_lines"/>
    </record>

</odoo>
