<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart buttons y campos adicionales en el formulario de equipo -->
    <record id="view_equipment_form_inherit_costs" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.costs</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <!-- Smart button: Costos -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_maintenance_costs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        groups="maintenance.group_equipment_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="maintenance_cost_total" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Costos</span>
                    </div>
                </button>
                <!-- Smart button: Costos históricos (sin factura) -->
                <button name="action_view_historic_costs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        invisible="historic_cost_total == 0"
                        groups="maintenance.group_equipment_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="historic_cost_total" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Histórico</span>
                    </div>
                </button>
                <!-- Smart button: Componentes -->
                <button name="action_view_components"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sitemap"
                        invisible="component_count == 0"
                        groups="maintenance.group_equipment_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="component_count"/>
                        </span>
                        <span class="o_stat_text">Componentes</span>
                    </div>
                </button>
                <!-- Smart button: Historial de ubicación -->
                <button name="action_view_location_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-map-marker"
                        invisible="location_history_count == 0"
                        groups="maintenance.group_equipment_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="location_history_count"/>
                        </span>
                        <span class="o_stat_text">Ubicaciones</span>
                    </div>
                </button>
                <!-- Smart button: Horómetro -->
                <button name="action_view_horometro_readings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tachometer"
                        groups="maintenance.group_equipment_manager">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="horometro_current" digits="[42,1]"/>
                            <span> hrs</span>
                        </span>
                        <span class="o_stat_text">Horómetro</span>
                    </div>
                </button>
            </xpath>

            <!-- Campo de ubicación (secadora.lugar).
                 Se ancla en category_id (siempre presente) en vez de owner_user_id,
                 porque el módulo core hr_maintenance reemplaza owner_user_id por
                 employee_id en el formulario cuando hr está instalado. -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="lugar_id"/>
                <field name="origen_muestra_id"/>
                <field name="parent_equipment_id"/>
            </xpath>

            <!-- Grupo de horómetro después del bloque principal de información -->
            <xpath expr="//group[@name='service_info_group']" position="after">
                <group string="Horómetro">
                    <field name="horometro_interval"/>
                    <field name="horometro_last_maintenance"/>
                    <field name="horometro_current" readonly="1"/>
                </group>
                <group string="Costos" name="costos_group">
                    <field name="maintenance_cost_total" readonly="1"/>
                    <field name="historic_cost_total" readonly="1"/>
                    <field name="maintenance_cost_grand_total" readonly="1"/>
                    <field name="external_ref" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
