<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Historial de ubicación de equipos ===== -->
    <record id="view_equipment_location_history_list" model="ir.ui.view">
        <field name="name">maintenance.equipment.location.history.list</field>
        <field name="model">maintenance.equipment.location.history</field>
        <field name="arch" type="xml">
            <list string="Historial de ubicación">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="equipment_id"/>
                <field name="lugar_id"/>
                <field name="origen_muestra_id" optional="show"/>
                <field name="parent_equipment_id" optional="hide"/>
                <field name="is_current" widget="boolean_toggle" readonly="1"/>
                <field name="origin" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_location_history_form" model="ir.ui.view">
        <field name="name">maintenance.equipment.location.history.form</field>
        <field name="model">maintenance.equipment.location.history</field>
        <field name="arch" type="xml">
            <form string="Ubicación del equipo">
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="lugar_id"/>
                            <field name="origen_muestra_id"/>
                            <field name="parent_equipment_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="is_current" readonly="1"/>
                            <field name="origin"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_equipment_location_history_search" model="ir.ui.view">
        <field name="name">maintenance.equipment.location.history.search</field>
        <field name="model">maintenance.equipment.location.history</field>
        <field name="arch" type="xml">
            <search string="Historial de ubicación">
                <field name="equipment_id"/>
                <field name="lugar_id"/>
                <filter name="filter_current" string="Ubicación actual"
                        domain="[('date_to', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_equipment" string="Equipo"
                            context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_lugar" string="Ubicación"
                            context="{'group_by': 'lugar_id'}"/>
                    <filter name="group_area" string="Área de proceso"
                            context="{'group_by': 'origen_muestra_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment_location_history" model="ir.actions.act_window">
        <field name="name">Historial de ubicación</field>
        <field name="res_model">maintenance.equipment.location.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_location_history_search"/>
    </record>

</odoo>
