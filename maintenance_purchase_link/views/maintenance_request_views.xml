<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_request_form_inherit_costs" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.costs</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <!--
                La vista nativa de maintenance.request en Odoo 18 no tiene button_box.
                Lo creamos al inicio del sheet, antes del primer div existente.
            -->
            <xpath expr="//sheet/div[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_costs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            groups="maintenance.group_equipment_manager">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="cost_total" widget="monetary"/>
                            </span>
                            <span class="o_stat_text">Costos</span>
                        </div>
                    </button>
                    <button name="action_assign_invoice"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            groups="maintenance.group_equipment_manager">
                        <span class="o_stat_text">Asignar factura</span>
                    </button>
                </div>
            </xpath>

            <!-- Número de OT encima del título, como identificador del documento.
                 Se ancla en el <label> del título: el <h1> ya está ocupado por
                 el nombre de la solicitud. -->
            <xpath expr="//div[hasclass('oe_title')]/label[@for='name']" position="before">
                <h2 class="mb-0" invisible="not ot_number">
                    <field name="ot_number" readonly="1" nolabel="1"
                           class="text-primary fw-bold"/>
                </h2>
            </xpath>

            <!-- Datos de origen para las OT importadas de Fracttal -->
            <xpath expr="//field[@name='maintenance_type']" position="after">
                <field name="task_name" readonly="1" invisible="not task_name"/>
                <field name="external_ref" readonly="1" invisible="not external_ref"/>
            </xpath>
        </field>
    </record>

    <!-- Número de OT en la lista -->
    <record id="view_request_list_inherit_ot" model="ir.ui.view">
        <field name="name">maintenance.request.list.inherit.ot</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="ot_number" string="Nro. OT"/>
            </field>
        </field>
    </record>

    <!-- Buscar por número de OT -->
    <record id="view_request_search_inherit_ot" model="ir.ui.view">
        <field name="name">maintenance.request.search.inherit.ot</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="ot_number" string="Nro. OT"/>
            </field>
        </field>
    </record>

</odoo>
